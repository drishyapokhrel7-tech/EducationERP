{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["electron-vite/node"]
  },
  "include": ["electron/**/*.ts", "electron.vite.config.ts"],
  "exclude": ["electron/**/*.spec.ts"]
}

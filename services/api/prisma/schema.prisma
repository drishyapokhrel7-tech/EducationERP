generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Organization / tenancy hierarchy (plan §6 "Organization") ──────────────
// Organization → Campus → Faculty → Department → Program → AcademicYear →
// Term → Section, matching plan §4's stated hierarchy exactly. Phase 1
// modeled only the top two tiers; Phase 2 completes the rest.

model Organization {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  campuses                 Campus[]
  users                    User[]
  roles                    Role[]
  auditLogs                AuditLog[]
  loginEvents              LoginEvent[]
  accessPolicies           AccessPolicy[]
  faculties                Faculty[]
  departments              Department[]
  programs                 Program[]
  academicYears            AcademicYear[]
  terms                    Term[]
  sections                 Section[]
  staffTypes               StaffType[]
  designations             Designation[]
  employees                Employee[]
  employmentHistories      EmploymentHistory[]
  qualifications           Qualification[]
  teacherProfiles          TeacherProfile[]
  subjects                 Subject[]
  curricula                Curriculum[]
  curriculumSubjects       CurriculumSubject[]
  students                 Student[]
  guardians                Guardian[]
  studentGuardians         StudentGuardian[]
  studentEnrollments       StudentEnrollment[]
  studentStatusHistories   StudentStatusHistory[]
  admissionApplications    AdmissionApplication[]
  admissionStatusHistories AdmissionStatusHistory[]
  rooms                    Room[]
  periods                  Period[]
  teachingAssignments      TeachingAssignment[]
  classSchedules           ClassSchedule[]
  attendanceSessions       AttendanceSession[]
  studentAttendances       StudentAttendance[]
  staffAttendances         StaffAttendance[]
  attendanceExceptions     AttendanceException[]
  syllabi                  Syllabus[]
  syllabusNodes            SyllabusNode[]
  learningObjectives       LearningObjective[]
  lessonPlans              LessonPlan[]
  classSessions            ClassSession[]
  classMaterials           ClassMaterial[]
  assignments              Assignment[]
  assignmentSubmissions    AssignmentSubmission[]
  knowledgeChecks          KnowledgeCheck[]
  knowledgeCheckQuestions  KnowledgeCheckQuestion[]
  knowledgeCheckAttempts   KnowledgeCheckAttempt[]
  examTypes                ExamType[]
  gradingSchemes           GradingScheme[]
  questionBanks            QuestionBank[]
  questions                Question[]
  exams                    Exam[]
  examSubjects             ExamSubject[]
  examSchedules            ExamSchedule[]
  examRooms                ExamRoom[]
  examAttempts             ExamAttempt[]
  marks                    Marks[]
  grades                   Grade[]
  reportCards              ReportCard[]

  @@map("organizations")
}

model Campus {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  code           String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  userRoles    UserRole[]
  faculties    Faculty[]
  rooms        Room[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("campuses")
}

model Faculty {
  id             String    @id @default(uuid())
  organizationId String
  campusId       String
  name           String
  code           String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  campus       Campus       @relation(fields: [campusId], references: [id])
  departments  Department[]

  @@unique([campusId, code])
  @@index([organizationId])
  @@map("faculties")
}

model Department {
  id             String    @id @default(uuid())
  organizationId String
  facultyId      String
  name           String
  code           String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization        Organization        @relation(fields: [organizationId], references: [id])
  faculty             Faculty             @relation(fields: [facultyId], references: [id])
  programs            Program[]
  employees           Employee[]
  employmentHistories EmploymentHistory[]

  @@unique([facultyId, code])
  @@index([organizationId])
  @@map("departments")
}

model Program {
  id                String    @id @default(uuid())
  organizationId    String
  departmentId      String
  name              String
  code              String
  // Free text, not an enum: institutions span schools (grades) and
  // colleges (degrees) with no fixed vocabulary — plan §1 explicitly
  // forbids hard-coding institution-specific structures like this.
  level             String?
  // Optional, generically applicable — not bachelor-specific despite
  // reading that way: a school program could set durationSemesters to
  // represent years just as validly. entranceExam is free text (e.g.
  // "IOST", "CMAT", "None"), never an enum of specific exam boards.
  durationSemesters Int?
  creditHours       Int?
  entranceExam      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  organization          Organization           @relation(fields: [organizationId], references: [id])
  department            Department             @relation(fields: [departmentId], references: [id])
  sections              Section[]
  curricula             Curriculum[]
  studentEnrollments    StudentEnrollment[]
  admissionApplications AdmissionApplication[]

  @@unique([departmentId, code])
  @@index([organizationId])
  @@map("programs")
}

// ── Academic (plan §6 "Academic", subjects/curriculum slice) ───────────────
// Subjects are an organization-wide catalog; a Curriculum names one
// subject *combination* for a Program (e.g. a school program has one
// curriculum, but a +2 Management program legitimately offers several
// distinct combinations — modeled as separate Curriculum rows under the
// same Program, not a single fixed list). Course/course_sections/
// teaching_assignments/class_schedules/rooms/periods (the
// scheduling-heavy remainder of plan §6 "Academic") are deferred to a
// later slice once Student enrollment exists to schedule around.

model Subject {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id])
  curriculumSubjects  CurriculumSubject[]
  teachingAssignments TeachingAssignment[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("subjects")
}

model Curriculum {
  id             String   @id @default(uuid())
  organizationId String
  programId      String
  name           String
  code           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id])
  program      Program             @relation(fields: [programId], references: [id])
  subjects     CurriculumSubject[]

  @@unique([programId, code])
  @@index([organizationId])
  @@map("curricula")
}

model CurriculumSubject {
  id             String   @id @default(uuid())
  organizationId String
  curriculumId   String
  subjectId      String
  isCompulsory   Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization  Organization   @relation(fields: [organizationId], references: [id])
  curriculum    Curriculum     @relation(fields: [curriculumId], references: [id])
  subject       Subject        @relation(fields: [subjectId], references: [id])
  syllabi       Syllabus[]
  questionBanks QuestionBank[]
  examSubjects  ExamSubject[]

  @@unique([curriculumId, subjectId])
  @@index([organizationId])
  @@map("curriculum_subjects")
}

model AcademicYear {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  startDate      DateTime
  endDate        DateTime
  isCurrent      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  terms        Term[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("academic_years")
}

model Term {
  id             String   @id @default(uuid())
  organizationId String
  academicYearId String
  name           String
  code           String
  sequence       Int
  startDate      DateTime
  endDate        DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id])
  academicYear        AcademicYear         @relation(fields: [academicYearId], references: [id])
  sections            Section[]
  studentEnrollments  StudentEnrollment[]
  teachingAssignments TeachingAssignment[]
  classSchedules      ClassSchedule[]
  syllabi             Syllabus[]
  exams               Exam[]

  @@unique([academicYearId, code])
  @@index([organizationId])
  @@map("terms")
}

model Section {
  id             String    @id @default(uuid())
  organizationId String
  programId      String
  termId         String
  name           String
  code           String
  capacity       Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization        Organization         @relation(fields: [organizationId], references: [id])
  program             Program              @relation(fields: [programId], references: [id])
  term                Term                 @relation(fields: [termId], references: [id])
  studentEnrollments  StudentEnrollment[]
  teachingAssignments TeachingAssignment[]
  classSchedules      ClassSchedule[]
  attendanceSessions  AttendanceSession[]
  classSessions       ClassSession[]

  @@unique([termId, programId, code])
  @@index([organizationId])
  @@map("sections")
}

// ── Security (plan §6 "Security" + §7 RBAC) ─────────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED
  DEACTIVATED
}

model User {
  id             String     @id @default(uuid())
  organizationId String
  email          String     @unique
  passwordHash   String
  firstName      String
  lastName       String
  status         UserStatus @default(INVITED)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  userRoles    UserRole[]
  sessions     Session[]
  loginEvents  LoginEvent[]
  auditLogs    AuditLog[]
  employee     Employee?
  student      Student?

  @@index([organizationId])
  @@map("users")
}

// System-defined role catalogue from plan §7. organizationId is null for
// the seeded system templates; an organization may in future clone one
// into an org-scoped custom role (out of scope for Phase 1).
model Role {
  id             String   @id @default(uuid())
  organizationId String?
  name           String
  description    String?
  isSystem       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization?    @relation(fields: [organizationId], references: [id])
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  // NB: Postgres treats NULL as distinct within a unique index, so this
  // constraint does not dedupe system roles (organizationId = null) —
  // only org-scoped custom roles. Seed script (prisma/seed.ts) handles
  // system-role idempotency with an explicit existence check instead.
  @@unique([organizationId, name])
  @@map("roles")
}

enum PermissionAction {
  VIEW
  CREATE
  UPDATE
  DELETE
  APPROVE
  EXPORT
  PRINT
  MANAGE
  ADMINISTER
}

model Permission {
  id          String           @id @default(uuid())
  resource    String
  action      PermissionAction
  description String?

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// A user's role assignment, optionally scoped to one campus. No campus
// scope = organization-wide (e.g. Org Admin).
model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  campusId  String?
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id])
  role   Role    @relation(fields: [roleId], references: [id])
  campus Campus? @relation(fields: [campusId], references: [id])

  @@unique([userId, roleId, campusId])
  @@index([userId])
  @@map("user_roles")
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

model LoginEvent {
  id             String   @id @default(uuid())
  organizationId String?
  userId         String?
  email          String
  success        Boolean
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@map("login_events")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  userId         String?
  action         String
  resource       String
  resourceId     String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([resource, resourceId])
  @@map("audit_logs")
}

model AccessPolicy {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  rules          Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name])
  @@map("access_policies")
}

// ── Staff (plan §6 "Staff") ──────────────────────────────────────────────
// teacher_subjects and staff_documents are deferred: the former needs
// Subject to exist (Academic structure, a later slice), the latter needs
// the Documents & Certificates domain (a later phase).

model StaffType {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  employees    Employee[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("staff_types")
}

model Designation {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization        Organization        @relation(fields: [organizationId], references: [id])
  employees           Employee[]
  employmentHistories EmploymentHistory[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("designations")
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

model Employee {
  id             String         @id @default(uuid())
  organizationId String
  // Set only for staff who also log in (teachers, admins, ...); many
  // support/non-teaching staff may never get a User account.
  userId         String?        @unique
  staffTypeId    String
  designationId  String
  departmentId   String?
  employeeCode   String
  firstName      String
  lastName       String
  email          String
  phone          String?
  dateOfJoining  DateTime
  status         EmployeeStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  organization            Organization         @relation(fields: [organizationId], references: [id])
  user                    User?                @relation(fields: [userId], references: [id])
  staffType               StaffType            @relation(fields: [staffTypeId], references: [id])
  designation             Designation          @relation(fields: [designationId], references: [id])
  department              Department?          @relation(fields: [departmentId], references: [id])
  employmentHistory       EmploymentHistory[]
  qualifications          Qualification[]
  teacherProfile          TeacherProfile?
  teachingAssignments     TeachingAssignment[]
  classSchedulesAsTeacher ClassSchedule[]
  staffAttendances        StaffAttendance[]

  @@unique([organizationId, employeeCode])
  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("employees")
}

model EmploymentHistory {
  id             String    @id @default(uuid())
  organizationId String
  employeeId     String
  designationId  String
  departmentId   String?
  startDate      DateTime
  endDate        DateTime?
  reason         String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])
  designation  Designation  @relation(fields: [designationId], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id])

  @@index([organizationId])
  @@index([employeeId])
  @@map("employment_history")
}

model Qualification {
  id             String   @id @default(uuid())
  organizationId String
  employeeId     String
  degree         String
  institution    String
  yearCompleted  Int?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])

  @@index([organizationId])
  @@index([employeeId])
  @@map("qualifications")
}

model TeacherProfile {
  id             String   @id @default(uuid())
  organizationId String
  employeeId     String   @unique
  bio            String?
  specialization String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])

  @@index([organizationId])
  @@map("teacher_profiles")
}

// ── Student (plan §6 "Student") ─────────────────────────────────────────────
// student_enrollments/student_programs/student_sections from the plan are
// collapsed into one StudentEnrollment table: which program, section and
// term a student is in for a given stretch is one coherent fact here, not
// three independently-varying ones — same "collapse when the shape is
// shared" call made for the org-hierarchy and staff slices. Deferred:
// student_addresses/student_photos/student_identifiers (no pressing need
// yet, easy to add as columns or tables later without a redesign) and
// student_documents (needs the Documents & Certificates domain, a later
// phase).

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  TRANSFERRED
  WITHDRAWN
}

model Student {
  id             String        @id @default(uuid())
  organizationId String
  // Set only if/when the student gets a portal login (plan §13 Student
  // dashboard) — not required for the administrative record to exist.
  userId         String?       @unique
  studentCode    String
  firstName      String
  lastName       String
  dateOfBirth    DateTime
  // Free text, not an enum — plan §1 forbids hard-coding
  // institution-specific vocabularies, and gender categories used on
  // admission forms vary by institution/jurisdiction.
  gender         String?
  status         StudentStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  organization           Organization            @relation(fields: [organizationId], references: [id])
  user                   User?                   @relation(fields: [userId], references: [id])
  guardians              StudentGuardian[]
  enrollments            StudentEnrollment[]
  statusHistory          StudentStatusHistory[]
  admissionApplication   AdmissionApplication?
  attendanceRecords      StudentAttendance[]
  assignmentSubmissions  AssignmentSubmission[]
  knowledgeCheckAttempts KnowledgeCheckAttempt[]
  examAttempts           ExamAttempt[]
  reportCards            ReportCard[]

  @@unique([organizationId, studentCode])
  @@index([organizationId])
  @@map("students")
}

model Guardian {
  id             String   @id @default(uuid())
  organizationId String
  firstName      String
  lastName       String
  phone          String
  email          String?
  occupation     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id])
  students     StudentGuardian[]

  @@index([organizationId])
  @@map("guardians")
}

model StudentGuardian {
  id               String   @id @default(uuid())
  organizationId   String
  studentId        String
  guardianId       String
  // Free text ("Father", "Mother", "Guardian", ...) — plan §1 again;
  // family structures aren't a fixed enum.
  relationship     String
  isPrimaryContact Boolean  @default(false)
  createdAt        DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id])
  guardian     Guardian     @relation(fields: [guardianId], references: [id])

  @@unique([studentId, guardianId])
  @@index([organizationId])
  @@map("student_guardians")
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  WITHDRAWN
}

model StudentEnrollment {
  id             String           @id @default(uuid())
  organizationId String
  studentId      String
  programId      String
  sectionId      String
  termId         String
  enrollmentDate DateTime
  status         EnrollmentStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id])
  program      Program      @relation(fields: [programId], references: [id])
  section      Section      @relation(fields: [sectionId], references: [id])
  term         Term         @relation(fields: [termId], references: [id])

  @@unique([studentId, termId])
  @@index([organizationId])
  @@map("student_enrollments")
}

model StudentStatusHistory {
  id             String        @id @default(uuid())
  organizationId String
  studentId      String
  status         StudentStatus
  reason         String?
  effectiveDate  DateTime
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id])

  @@index([organizationId])
  @@index([studentId])
  @@map("student_status_history")
}

// ── Admissions (plan §5 "Admissions") ───────────────────────────────────────
// A scoped-down first slice of the plan's full Admissions scope (online
// applications, document upload, review, scoring, entrance exams,
// interviews, merit lists, approval, admission fees, enrollment,
// configurable workflows): application intake, status review with an
// audit trail, and the enroll action that turns an approved application
// into a real Student + StudentEnrollment. Deferred: document upload
// (needs an object-storage decision, still an open item — see
// PHASE_1_NOTES.md), admission fees (needs the Finance domain), merit
// lists (a derived/computed view over applications, not its own data),
// configurable workflows (far beyond this slice).

enum AdmissionStatus {
  SUBMITTED
  UNDER_REVIEW
  INTERVIEW_SCHEDULED
  APPROVED
  REJECTED
  ENROLLED
}

model AdmissionApplication {
  id                 String          @id @default(uuid())
  organizationId     String
  programId          String
  applicantFirstName String
  applicantLastName  String
  dateOfBirth        DateTime
  gender             String?
  guardianName       String?
  guardianPhone      String?
  appliedDate        DateTime
  status             AdmissionStatus @default(SUBMITTED)
  // Entrance-exam/interview score — a plain number, not tied to any
  // specific exam's scale (plan §1: don't hard-code institution-specific
  // structures).
  score              Float?
  notes              String?
  // Set only once the enroll action has run; the application row is kept
  // afterward as the historical record of how this student was admitted.
  enrolledStudentId  String?         @unique
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  organization    Organization             @relation(fields: [organizationId], references: [id])
  program         Program                  @relation(fields: [programId], references: [id])
  enrolledStudent Student?                 @relation(fields: [enrolledStudentId], references: [id])
  statusHistory   AdmissionStatusHistory[]

  @@index([organizationId])
  @@map("admission_applications")
}

model AdmissionStatusHistory {
  id             String          @id @default(uuid())
  organizationId String
  applicationId  String
  status         AdmissionStatus
  reason         String?
  effectiveDate  DateTime
  createdAt      DateTime        @default(now())

  organization Organization         @relation(fields: [organizationId], references: [id])
  application  AdmissionApplication @relation(fields: [applicationId], references: [id])

  @@index([organizationId])
  @@index([applicationId])
  @@map("admission_status_history")
}

// ── Timetable & Scheduling (plan §6 "Academic": rooms, periods,
// teaching_assignments, class_schedules — Phase 3 slice 3a) ────────────────
// Section/Program/Term/Subject/Employee already exist from Phase 2; this
// slice is the first piece of Phase 3 (Teaching, Learning, Timetable &
// Attendance) and everything else in that phase (syllabus, lesson plans,
// class sessions, "My Classes Today") is built on top of the weekly
// schedule this establishes.

model Room {
  id             String    @id @default(uuid())
  organizationId String
  campusId       String
  name           String
  code           String
  capacity       Int?
  // Free text, not an enum — same reasoning as Program.level: room
  // taxonomies (classroom/lab/auditorium/workshop) vary by institution
  // type and plan §1 forbids hard-coding this kind of vocabulary.
  roomType       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization   Organization    @relation(fields: [organizationId], references: [id])
  campus         Campus          @relation(fields: [campusId], references: [id])
  classSchedules ClassSchedule[]
  examRooms      ExamRoom[]

  @@unique([campusId, code])
  @@index([organizationId])
  @@map("rooms")
}

model Period {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String
  // Ordering within a day (Period 1, Period 2, ...) — display only, not
  // used for conflict checks (dayOfWeek + periodId does that).
  sequence       Int
  // "HH:mm" 24-hour strings, not a Time/DateTime column — a period is a
  // recurring daily slot with no date component, and Postgres's `time`
  // type doesn't map to a native Prisma scalar without extra tooling.
  startTime      String
  endTime        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id])
  classSchedules ClassSchedule[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("periods")
}

model TeachingAssignment {
  id             String   @id @default(uuid())
  organizationId String
  employeeId     String
  subjectId      String
  sectionId      String
  termId         String
  createdAt      DateTime @default(now())

  organization    Organization     @relation(fields: [organizationId], references: [id])
  employee        Employee         @relation(fields: [employeeId], references: [id])
  subject         Subject          @relation(fields: [subjectId], references: [id])
  section         Section          @relation(fields: [sectionId], references: [id])
  term            Term             @relation(fields: [termId], references: [id])
  classSchedules  ClassSchedule[]
  lessonPlans     LessonPlan[]
  assignments     Assignment[]
  knowledgeChecks KnowledgeCheck[]

  // One teacher per subject+section+term — re-assigning means changing
  // this row, not stacking a second one alongside it.
  @@unique([sectionId, subjectId, termId])
  @@index([organizationId])
  @@map("teaching_assignments")
}

model ClassSchedule {
  id                   String   @id @default(uuid())
  organizationId       String
  termId               String
  teachingAssignmentId String
  // sectionId and teacherId are denormalized off teachingAssignment
  // (not just a convenience) — Postgres unique constraints need real
  // columns to enforce "no double-booking" at the database level, not
  // just in application code, the same reasoning every prior slice
  // applied to FK-vs-RLS parent guards.
  sectionId            String
  teacherId            String
  roomId               String
  periodId             String
  // 1=Monday .. 7=Sunday (ISO 8601), not an enum — day-name vocabularies
  // and week structures vary by institution/locale (plan §1).
  dayOfWeek            Int
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id])
  term               Term                @relation(fields: [termId], references: [id])
  teachingAssignment TeachingAssignment  @relation(fields: [teachingAssignmentId], references: [id])
  section            Section             @relation(fields: [sectionId], references: [id])
  teacher            Employee            @relation(fields: [teacherId], references: [id])
  room               Room                @relation(fields: [roomId], references: [id])
  period             Period              @relation(fields: [periodId], references: [id])
  attendanceSessions AttendanceSession[]
  classSessions      ClassSession[]

  @@unique([termId, roomId, dayOfWeek, periodId], map: "class_schedules_room_slot_key")
  @@unique([termId, sectionId, dayOfWeek, periodId], map: "class_schedules_section_slot_key")
  @@unique([termId, teacherId, dayOfWeek, periodId], map: "class_schedules_teacher_slot_key")
  @@index([organizationId])
  @@map("class_schedules")
}

// ── Attendance (plan §6 "Attendance" — Phase 3 slice 3b) ────────────────────
// Scoped to manual/session-based attendance only: attendance_devices,
// attendance_events and entry_exit_records (the automated-capture side of
// plan §6's Attendance group) belong with Phase 6 (CCTV/Biometric), where
// the capture hardware/pipeline that would ever populate them actually
// gets built — building those tables now would just be unused schema.

model AttendanceSession {
  id              String   @id @default(uuid())
  organizationId  String
  classScheduleId String
  // Denormalized off classSchedule — same reasoning as ClassSchedule's own
  // sectionId/teacherId: the roster query and the one-session-per-slot-
  // per-day uniqueness both need a real column, not a join.
  sectionId       String
  date            DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization      Organization        @relation(fields: [organizationId], references: [id])
  classSchedule     ClassSchedule       @relation(fields: [classScheduleId], references: [id])
  section           Section             @relation(fields: [sectionId], references: [id])
  studentAttendance StudentAttendance[]

  @@unique([classScheduleId, date])
  @@index([organizationId])
  @@map("attendance_sessions")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model StudentAttendance {
  id                  String           @id @default(uuid())
  organizationId      String
  attendanceSessionId String
  studentId           String
  status              AttendanceStatus
  remarks             String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id])
  session      AttendanceSession     @relation(fields: [attendanceSessionId], references: [id])
  student      Student               @relation(fields: [studentId], references: [id])
  exceptions   AttendanceException[]

  @@unique([attendanceSessionId, studentId])
  @@index([organizationId])
  @@map("student_attendance")
}

// A correction's audit trail — every status change after the initial mark
// (made via the bulk mark action, not this model) is recorded here with a
// reason, same pattern as StudentStatusHistory/AdmissionStatusHistory.
model AttendanceException {
  id                  String           @id @default(uuid())
  organizationId      String
  studentAttendanceId String
  previousStatus      AttendanceStatus
  newStatus           AttendanceStatus
  reason              String
  createdAt           DateTime         @default(now())

  organization      Organization      @relation(fields: [organizationId], references: [id])
  studentAttendance StudentAttendance @relation(fields: [studentAttendanceId], references: [id])

  @@index([organizationId])
  @@index([studentAttendanceId])
  @@map("attendance_exceptions")
}

enum StaffAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  ON_LEAVE
  HALF_DAY
}

model StaffAttendance {
  id             String                @id @default(uuid())
  organizationId String
  employeeId     String
  date           DateTime
  status         StaffAttendanceStatus
  remarks        String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@index([organizationId])
  @@map("staff_attendance")
}

// ── Syllabus & Lesson Plans (plan §6 "Teaching & Learning" — Phase 3
// slice 3c) ──────────────────────────────────────────────────────────────
// syllabus_versions is deliberately not modeled — no revision-history
// requirement has been specified yet (same "defer until asked" reasoning
// every prior slice has applied to unspecified scope); Syllabus is
// directly editable, the same way Program/Subject are.
//
// unit/chapter/topic/subtopic collapse into one self-referencing tree
// (SyllabusNode + a level marker) instead of four near-identical tables —
// same reasoning as StudentEnrollment's and ClassSchedule's earlier
// collapses: all four are the same shape (ordered, named, nested under a
// parent). The four-level enum itself is a property of this workflow
// (plan §8 names exactly these four levels), not an institution-specific
// taxonomy plan §1 forbids hard-coding, so an enum is appropriate here
// unlike e.g. Room.roomType.

model Syllabus {
  id                  String   @id @default(uuid())
  organizationId      String
  curriculumSubjectId String
  termId              String
  name                String?
  description         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization      Organization      @relation(fields: [organizationId], references: [id])
  curriculumSubject CurriculumSubject @relation(fields: [curriculumSubjectId], references: [id])
  term              Term              @relation(fields: [termId], references: [id])
  nodes             SyllabusNode[]

  // One syllabus per curriculum-subject+term — revising means editing
  // this row's nodes, not creating a second syllabus alongside it.
  @@unique([curriculumSubjectId, termId])
  @@index([organizationId])
  @@map("syllabi")
}

enum SyllabusNodeLevel {
  UNIT
  CHAPTER
  TOPIC
  SUBTOPIC
}

model SyllabusNode {
  id             String            @id @default(uuid())
  organizationId String
  syllabusId     String
  parentId       String?
  level          SyllabusNodeLevel
  // Ordering among siblings under the same parent (or top-level within
  // the syllabus for UNIT nodes) — display only.
  sequence       Int
  name           String
  description    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id])
  syllabus           Syllabus            @relation(fields: [syllabusId], references: [id])
  parent             SyllabusNode?       @relation("SyllabusNodeChildren", fields: [parentId], references: [id])
  children           SyllabusNode[]      @relation("SyllabusNodeChildren")
  learningObjectives LearningObjective[]
  lessonPlans        LessonPlan[]
  classSessions      ClassSession[]
  knowledgeChecks    KnowledgeCheck[]

  @@index([organizationId])
  @@index([syllabusId])
  @@index([parentId])
  @@map("syllabus_nodes")
}

model LearningObjective {
  id             String   @id @default(uuid())
  organizationId String
  syllabusNodeId String
  sequence       Int
  description    String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  node         SyllabusNode @relation(fields: [syllabusNodeId], references: [id])

  @@index([organizationId])
  @@index([syllabusNodeId])
  @@map("learning_objectives")
}

// Tied to a TeachingAssignment (teacher+subject+section+term) and a
// SyllabusNode (what's being taught), not to a specific ClassSchedule
// occurrence or calendar date — a lesson plan is content a teacher
// prepares once and may reuse across sessions; binding it to one actual
// dated occurrence is 3d's job (class sessions / "My Classes Today"),
// not this slice's.
model LessonPlan {
  id                   String    @id @default(uuid())
  organizationId       String
  teachingAssignmentId String
  syllabusNodeId       String
  title                String
  objectives           String
  materials            String?
  plannedDate          DateTime?
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization       Organization       @relation(fields: [organizationId], references: [id])
  teachingAssignment TeachingAssignment @relation(fields: [teachingAssignmentId], references: [id])
  syllabusNode       SyllabusNode       @relation(fields: [syllabusNodeId], references: [id])
  classSessions      ClassSession[]

  @@index([organizationId])
  @@index([teachingAssignmentId])
  @@map("lesson_plans")
}

// ── Class Sessions (plan §6 "Teaching & Learning" — Phase 3 slice 3d) ──────
// Distinct from AttendanceSession (slice 3b): a ClassSession tracks what
// was actually *taught* (topic, progress, materials, completion), an
// AttendanceSession tracks who was *there* — the plan lists them as
// separate tables under separate domains, and the class-completion
// workflow (plan §8) treats "confirm attendance" and "select actual
// topic / record progress / mark completed" as separate steps. Both key
// off the same (classScheduleId, date) pair but are otherwise
// independent; the API surfaces both when listing a day's classes rather
// than merging them into one model.
//
// syllabus_progress is deliberately not a stored table — per-node
// progress (was this topic actually covered, and when) is fully derivable
// by querying ClassSession rows for COMPLETED sessions whose
// actualSyllabusNodeId matches a node, so a separate denormalized table
// would just be a second source of truth to keep in sync on every
// completion. Computed on read instead (plan §17 explicitly allows
// "materialized views/aggregation ... where appropriate" — an on-demand
// computed view is the simpler appropriate choice here, not a stored one).

enum ClassSessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

model ClassSession {
  id                   String             @id @default(uuid())
  organizationId       String
  classScheduleId      String
  // Denormalized off classSchedule, same reasoning as every prior
  // slice's session-shaped models (AttendanceSession, ClassSchedule
  // itself) — needed directly for the unique constraint and for
  // listing/filtering without a join.
  sectionId            String
  date                 DateTime
  lessonPlanId         String?
  // What was actually covered — may differ from the lesson plan's
  // intended node, which is exactly the "planned vs actual" distinction
  // plan §8 calls out.
  actualSyllabusNodeId String?
  progressNotes        String?
  status               ClassSessionStatus @default(SCHEDULED)
  completedAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization       Organization    @relation(fields: [organizationId], references: [id])
  classSchedule      ClassSchedule   @relation(fields: [classScheduleId], references: [id])
  section            Section         @relation(fields: [sectionId], references: [id])
  lessonPlan         LessonPlan?     @relation(fields: [lessonPlanId], references: [id])
  actualSyllabusNode SyllabusNode?   @relation(fields: [actualSyllabusNodeId], references: [id])
  materials          ClassMaterial[]

  @@unique([classScheduleId, date])
  @@index([organizationId])
  @@map("class_sessions")
}

// No file upload (same reasoning as every prior slice touching
// documents): the object-storage backend is still an open decision, and
// a class material here is a reference (title + optional link), not an
// uploaded file.
model ClassMaterial {
  id             String   @id @default(uuid())
  organizationId String
  classSessionId String
  title          String
  url            String?
  description    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  classSession ClassSession @relation(fields: [classSessionId], references: [id])

  @@index([organizationId])
  @@index([classSessionId])
  @@map("class_materials")
}

// ── Assignments & Knowledge Checks (plan §6 "Teaching & Learning" —
// Phase 3 slice 3e) ─────────────────────────────────────────────────────
// AI generation of either (plan §9's AI Knowledge Check/Assignment
// Generators) is explicitly Phase 5 scope, not this slice — this builds
// the real manual mechanics those generators will later populate.
//
// rubrics/rubric_items are deliberately not modeled — no structured-
// criteria grading requirement has been specified yet, so a plain
// score + feedback covers "grading and feedback" (plan §8) for now,
// same "defer until asked" reasoning applied to every prior slice's
// unspecified scope (e.g. slice 3c's syllabus_versions).
//
// knowledge_check "options" collapse into a JSON array on the question
// itself instead of a separate rubric_items-shaped child table — same
// collapsing reasoning as SyllabusNode: each option has no independent
// identity or behavior beyond "one of this question's choices."
//
// Neither Assignment nor KnowledgeCheck exists in a real student-facing
// portal yet (no student/parent login — a gap already noted in earlier
// phases), so submissions/attempts are recorded by admin on a student's
// behalf, the same pattern StudentAttendance already established.

enum SubmissionType {
  WRITTEN
  OBJECTIVE
  PROJECT
  PRACTICAL
  FILE
  IMAGE
  PDF
  LINK
  TEXT
}

model Assignment {
  id                   String         @id @default(uuid())
  organizationId       String
  teachingAssignmentId String
  title                String
  description          String?
  submissionType       SubmissionType
  dueDate              DateTime?
  allowResubmission    Boolean        @default(false)
  maxScore             Float?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  organization       Organization           @relation(fields: [organizationId], references: [id])
  teachingAssignment TeachingAssignment     @relation(fields: [teachingAssignmentId], references: [id])
  submissions        AssignmentSubmission[]

  @@index([organizationId])
  @@map("assignments")
}

enum SubmissionStatus {
  SUBMITTED
  GRADED
}

model AssignmentSubmission {
  id             String           @id @default(uuid())
  organizationId String
  assignmentId   String
  studentId      String
  // Text or a link — no file upload, same reasoning as ClassMaterial;
  // FILE/IMAGE/PDF submission types store a reference here, not bytes.
  content        String?
  submittedAt    DateTime         @default(now())
  status         SubmissionStatus @default(SUBMITTED)
  score          Float?
  feedback       String?
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  assignment   Assignment   @relation(fields: [assignmentId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id])

  // One row per student per assignment — a resubmission (when the
  // assignment allows it) overwrites this row rather than stacking a
  // new one, so "latest submission" never needs a separate query.
  @@unique([assignmentId, studentId])
  @@index([organizationId])
  @@map("assignment_submissions")
}

enum KnowledgeCheckStatus {
  DRAFT
  PUBLISHED
}

model KnowledgeCheck {
  id                   String               @id @default(uuid())
  organizationId       String
  teachingAssignmentId String
  syllabusNodeId       String?
  title                String
  durationMinutes      Int?
  status               KnowledgeCheckStatus @default(DRAFT)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  organization       Organization             @relation(fields: [organizationId], references: [id])
  teachingAssignment TeachingAssignment       @relation(fields: [teachingAssignmentId], references: [id])
  syllabusNode       SyllabusNode?            @relation(fields: [syllabusNodeId], references: [id])
  questions          KnowledgeCheckQuestion[]
  attempts           KnowledgeCheckAttempt[]

  @@index([organizationId])
  @@map("knowledge_checks")
}

model KnowledgeCheckQuestion {
  id                 String   @id @default(uuid())
  organizationId     String
  knowledgeCheckId   String
  sequence           Int
  text               String
  // string[] — the answer choices, in display order.
  options            Json
  correctOptionIndex Int
  createdAt          DateTime @default(now())

  organization   Organization   @relation(fields: [organizationId], references: [id])
  knowledgeCheck KnowledgeCheck @relation(fields: [knowledgeCheckId], references: [id])

  @@index([organizationId])
  @@index([knowledgeCheckId])
  @@map("knowledge_check_questions")
}

model KnowledgeCheckAttempt {
  id               String   @id @default(uuid())
  organizationId   String
  knowledgeCheckId String
  studentId        String
  // number[] — the selected option index per question, in the same
  // order as KnowledgeCheck.questions.
  answers          Json
  // Percentage of questions answered correctly, computed server-side at
  // submission time — never trust a client-submitted score.
  score            Float
  submittedAt      DateTime @default(now())

  organization   Organization   @relation(fields: [organizationId], references: [id])
  knowledgeCheck KnowledgeCheck @relation(fields: [knowledgeCheckId], references: [id])
  student        Student        @relation(fields: [studentId], references: [id])

  // One attempt per student — these are short in-class checks, not a
  // retake-until-you-pass assessment; resubmission rules are an
  // Assignment concept, not a KnowledgeCheck one.
  @@unique([knowledgeCheckId, studentId])
  @@index([organizationId])
  @@map("knowledge_check_attempts")
}

// --- Phase 4 slice 4a: exam structure & question banks -------------------
// Foundation for the rest of Phase 4 (exams/scheduling in 4b, attempts/
// evaluation in 4c, grades/report cards in 4d) — see docs/PHASE_4_NOTES.md.

model ExamType {
  id             String   @id @default(uuid())
  organizationId String
  // e.g. "Terminal Exam", "Unit Test", "Final Exam" — an institution-
  // defined category an Exam (4b) will reference, same role StaffType
  // plays for Employee.
  name           String
  code           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  exams        Exam[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("exam_types")
}

model GradingScheme {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String
  description    String?
  // Array of { minPercentage, maxPercentage, grade, gpa?, remarks? },
  // ordered highest-to-lowest — a separate grade_bands table isn't
  // listed in the plan's flat table list for this domain, and a band
  // has no independent identity/behavior beyond "one row of this
  // scheme's scale," the same collapsing reasoning already applied to
  // KnowledgeCheckQuestion.options and Assignment's rubric fields.
  bands          Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  exams        Exam[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("grading_schemes")
}

model QuestionBank {
  id                  String   @id @default(uuid())
  organizationId      String
  // Not term-scoped like Syllabus — a bank of questions for a subject
  // is reusable across exams and terms, unlike a syllabus which tracks
  // one term's actual coverage.
  curriculumSubjectId String
  name                String
  description         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization      Organization      @relation(fields: [organizationId], references: [id])
  curriculumSubject CurriculumSubject @relation(fields: [curriculumSubjectId], references: [id])
  questions         Question[]

  @@index([organizationId])
  @@index([curriculumSubjectId])
  @@map("question_banks")
}

enum QuestionType {
  // Single correct choice among `options`, auto-scored later (4c) —
  // never trust a client-submitted score, same rule as KnowledgeCheck.
  OBJECTIVE
  // Free-text, manually marked — no options/correctOptionIndex.
  SUBJECTIVE
}

model Question {
  id                 String       @id @default(uuid())
  organizationId     String
  questionBankId     String
  sequence           Int
  text               String
  questionType       QuestionType
  // Points this question is worth within any exam that draws on it.
  marks              Int
  // string[], OBJECTIVE only — the answer choices, in display order.
  options            Json?
  // OBJECTIVE only.
  correctOptionIndex Int?
  // SUBJECTIVE only, optional — a reference answer/marking note for
  // the human grader; never used for auto-scoring.
  modelAnswer        String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  questionBank QuestionBank @relation(fields: [questionBankId], references: [id])

  @@index([organizationId])
  @@index([questionBankId])
  @@map("questions")
}

model Exam {
  id              String   @id @default(uuid())
  organizationId  String
  examTypeId      String
  termId          String
  name            String
  // Optional — an exam can exist before its grading scale is decided;
  // 4d's grade computation requires it, this slice's scheduling doesn't.
  gradingSchemeId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id])
  examType      ExamType       @relation(fields: [examTypeId], references: [id])
  term          Term           @relation(fields: [termId], references: [id])
  gradingScheme GradingScheme? @relation(fields: [gradingSchemeId], references: [id])
  examSubjects  ExamSubject[]
  reportCards   ReportCard[]

  @@index([organizationId])
  @@index([termId])
  @@map("exams")
}

model ExamSubject {
  id                  String   @id @default(uuid())
  organizationId      String
  examId              String
  curriculumSubjectId String
  fullMarks           Int
  passMarks           Int
  createdAt           DateTime @default(now())

  organization      Organization      @relation(fields: [organizationId], references: [id])
  exam              Exam              @relation(fields: [examId], references: [id])
  curriculumSubject CurriculumSubject @relation(fields: [curriculumSubjectId], references: [id])
  // At most one schedule per exam subject — a subject is examined once
  // within a given exam sitting; a subject with a written and a
  // practical component is two ExamSubject rows (two CurriculumSubject-
  // level marks entries), not one ExamSubject with two schedules.
  examSchedule      ExamSchedule?
  examAttempts      ExamAttempt[]

  @@unique([examId, curriculumSubjectId])
  @@index([organizationId])
  @@map("exam_subjects")
}

model ExamSchedule {
  id             String   @id @default(uuid())
  organizationId String
  examSubjectId  String   @unique
  date           DateTime
  // "HH:mm" 24-hour strings — same reasoning as Period's startTime/
  // endTime, a real Postgres `time` column doesn't map to a native
  // Prisma scalar without extra tooling.
  startTime      String
  endTime        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  examSubject  ExamSubject  @relation(fields: [examSubjectId], references: [id])
  examRooms    ExamRoom[]

  @@index([organizationId])
  @@map("exam_schedules")
}

model ExamRoom {
  id             String   @id @default(uuid())
  organizationId String
  examScheduleId String
  roomId         String
  // A large sitting can split across multiple rooms — capacity tracks
  // how many seats this room contributes, not a hard cap enforced here.
  capacity       Int?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  examSchedule ExamSchedule @relation(fields: [examScheduleId], references: [id])
  room         Room         @relation(fields: [roomId], references: [id])

  @@unique([examScheduleId, roomId])
  @@index([organizationId])
  @@index([roomId])
  @@map("exam_rooms")
}

model ExamAttempt {
  id             String           @id @default(uuid())
  organizationId String
  examSubjectId  String
  studentId      String
  // Reuses AttendanceStatus (present/absent/late/excused) rather than a
  // new narrower enum — the same four values are meaningful for "did
  // this student sit this exam" as for daily class attendance, and
  // introducing a parallel enum for identical semantics would be a new
  // abstraction with no behavioral difference.
  status         AttendanceStatus @default(PRESENT)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  examSubject  ExamSubject  @relation(fields: [examSubjectId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id])
  marks        Marks?
  grade        Grade?

  // One attempt per student per exam subject — admin-recorded on the
  // student's behalf, same pattern as AssignmentSubmission/
  // KnowledgeCheckAttempt (no student portal exists yet). Deliberately
  // not roster-based like AttendanceSession: an exam subject has no
  // direct sectionId to compute a roster from (it's reached via
  // CurriculumSubject, which can span multiple sections/programs), so
  // admin picks the specific student explicitly, the same choice
  // already made for assignments and knowledge checks.
  @@unique([examSubjectId, studentId])
  @@index([organizationId])
  @@map("exam_attempts")
}

model Marks {
  id             String   @id @default(uuid())
  organizationId String
  examAttemptId  String   @unique
  obtainedMarks  Int
  remarks        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  examAttempt  ExamAttempt  @relation(fields: [examAttemptId], references: [id])

  @@index([organizationId])
  @@map("marks")
}

model Grade {
  id             String   @id @default(uuid())
  organizationId String
  examAttemptId  String   @unique
  // Snapshotted at computation time, not recomputed on read — a grade
  // is meant to be stable even if the grading scheme's bands change
  // later (e.g. an institution revises cutoffs after report cards have
  // already been issued).
  percentage     Float
  grade          String
  gpa            Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  examAttempt  ExamAttempt  @relation(fields: [examAttemptId], references: [id])

  @@index([organizationId])
  @@map("grades")
}

model ReportCard {
  id                 String   @id @default(uuid())
  organizationId     String
  examId             String
  studentId          String
  totalObtainedMarks Int
  totalFullMarks     Int
  percentage         Float
  overallGrade       String
  overallGpa         Float?
  // The per-subject breakdown isn't duplicated here — it's already
  // queryable via Grade rows joined through ExamAttempt/ExamSubject for
  // this exam+student, and storing a second copy would just be a sync
  // hazard. This row snapshots only the aggregate figures, the part
  // that's actually a computation over multiple rows at a point in time.
  generatedAt        DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  exam         Exam         @relation(fields: [examId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id])

  @@unique([examId, studentId])
  @@index([organizationId])
  @@map("report_cards")
}

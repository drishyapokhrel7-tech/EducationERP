generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Organization / tenancy hierarchy (plan §6 "Organization") ──────────────
// Organization → Campus → Faculty → Department → Program → AcademicYear →
// Term → Section, matching plan §4's stated hierarchy exactly. Phase 1
// modeled only the top two tiers; Phase 2 completes the rest.

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  campuses  Campus[]
  users     User[]
  roles     Role[]
  auditLogs AuditLog[]
  loginEvents LoginEvent[]
  accessPolicies AccessPolicy[]
  faculties      Faculty[]
  departments    Department[]
  programs       Program[]
  academicYears  AcademicYear[]
  terms          Term[]
  sections       Section[]
  staffTypes     StaffType[]
  designations   Designation[]
  employees      Employee[]
  employmentHistories EmploymentHistory[]
  qualifications      Qualification[]
  teacherProfiles     TeacherProfile[]

  @@map("organizations")
}

model Campus {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  userRoles    UserRole[]
  faculties    Faculty[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("campuses")
}

model Faculty {
  id             String   @id @default(uuid())
  organizationId String
  campusId       String
  name           String
  code           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  campus       Campus       @relation(fields: [campusId], references: [id])
  departments  Department[]

  @@unique([campusId, code])
  @@index([organizationId])
  @@map("faculties")
}

model Department {
  id             String   @id @default(uuid())
  organizationId String
  facultyId      String
  name           String
  code           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization        Organization        @relation(fields: [organizationId], references: [id])
  faculty             Faculty             @relation(fields: [facultyId], references: [id])
  programs            Program[]
  employees           Employee[]
  employmentHistories EmploymentHistory[]

  @@unique([facultyId, code])
  @@index([organizationId])
  @@map("departments")
}

model Program {
  id             String   @id @default(uuid())
  organizationId String
  departmentId   String
  name           String
  code           String
  // Free text, not an enum: institutions span schools (grades) and
  // colleges (degrees) with no fixed vocabulary — plan §1 explicitly
  // forbids hard-coding institution-specific structures like this.
  level          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  department   Department   @relation(fields: [departmentId], references: [id])
  sections     Section[]

  @@unique([departmentId, code])
  @@index([organizationId])
  @@map("programs")
}

model AcademicYear {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  startDate      DateTime
  endDate        DateTime
  isCurrent      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  terms        Term[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("academic_years")
}

model Term {
  id             String   @id @default(uuid())
  organizationId String
  academicYearId String
  name           String
  code           String
  sequence       Int
  startDate      DateTime
  endDate        DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  sections     Section[]

  @@unique([academicYearId, code])
  @@index([organizationId])
  @@map("terms")
}

model Section {
  id             String   @id @default(uuid())
  organizationId String
  programId      String
  termId         String
  name           String
  code           String
  capacity       Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  program      Program      @relation(fields: [programId], references: [id])
  term         Term         @relation(fields: [termId], references: [id])

  @@unique([termId, programId, code])
  @@index([organizationId])
  @@map("sections")
}

// ── Security (plan §6 "Security" + §7 RBAC) ─────────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED
  DEACTIVATED
}

model User {
  id             String     @id @default(uuid())
  organizationId String
  email          String     @unique
  passwordHash   String
  firstName      String
  lastName       String
  status         UserStatus @default(INVITED)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  userRoles    UserRole[]
  sessions     Session[]
  loginEvents  LoginEvent[]
  auditLogs    AuditLog[]
  employee     Employee?

  @@index([organizationId])
  @@map("users")
}

// System-defined role catalogue from plan §7. organizationId is null for
// the seeded system templates; an organization may in future clone one
// into an org-scoped custom role (out of scope for Phase 1).
model Role {
  id             String   @id @default(uuid())
  organizationId String?
  name           String
  description    String?
  isSystem       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization?    @relation(fields: [organizationId], references: [id])
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  // NB: Postgres treats NULL as distinct within a unique index, so this
  // constraint does not dedupe system roles (organizationId = null) —
  // only org-scoped custom roles. Seed script (prisma/seed.ts) handles
  // system-role idempotency with an explicit existence check instead.
  @@unique([organizationId, name])
  @@map("roles")
}

enum PermissionAction {
  VIEW
  CREATE
  UPDATE
  DELETE
  APPROVE
  EXPORT
  PRINT
  MANAGE
  ADMINISTER
}

model Permission {
  id          String            @id @default(uuid())
  resource    String
  action      PermissionAction
  description String?

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// A user's role assignment, optionally scoped to one campus. No campus
// scope = organization-wide (e.g. Org Admin).
model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  campusId  String?
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id])
  role   Role    @relation(fields: [roleId], references: [id])
  campus Campus? @relation(fields: [campusId], references: [id])

  @@unique([userId, roleId, campusId])
  @@index([userId])
  @@map("user_roles")
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

model LoginEvent {
  id             String   @id @default(uuid())
  organizationId String?
  userId         String?
  email          String
  success        Boolean
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@map("login_events")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  userId         String?
  action         String
  resource       String
  resourceId     String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([resource, resourceId])
  @@map("audit_logs")
}

model AccessPolicy {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  rules          Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name])
  @@map("access_policies")
}

// ── Staff (plan §6 "Staff") ──────────────────────────────────────────────
// teacher_subjects and staff_documents are deferred: the former needs
// Subject to exist (Academic structure, a later slice), the latter needs
// the Documents & Certificates domain (a later phase).

model StaffType {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  employees    Employee[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("staff_types")
}

model Designation {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id])
  employees           Employee[]
  employmentHistories EmploymentHistory[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("designations")
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

model Employee {
  id             String         @id @default(uuid())
  organizationId String
  // Set only for staff who also log in (teachers, admins, ...); many
  // support/non-teaching staff may never get a User account.
  userId         String?        @unique
  staffTypeId    String
  designationId  String
  departmentId   String?
  employeeCode   String
  firstName      String
  lastName       String
  email          String
  phone          String?
  dateOfJoining  DateTime
  status         EmployeeStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  organization      Organization        @relation(fields: [organizationId], references: [id])
  user               User?               @relation(fields: [userId], references: [id])
  staffType          StaffType           @relation(fields: [staffTypeId], references: [id])
  designation        Designation         @relation(fields: [designationId], references: [id])
  department         Department?         @relation(fields: [departmentId], references: [id])
  employmentHistory  EmploymentHistory[]
  qualifications     Qualification[]
  teacherProfile     TeacherProfile?

  @@unique([organizationId, employeeCode])
  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("employees")
}

model EmploymentHistory {
  id             String    @id @default(uuid())
  organizationId String
  employeeId     String
  designationId  String
  departmentId   String?
  startDate      DateTime
  endDate        DateTime?
  reason         String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])
  designation  Designation  @relation(fields: [designationId], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id])

  @@index([organizationId])
  @@index([employeeId])
  @@map("employment_history")
}

model Qualification {
  id             String   @id @default(uuid())
  organizationId String
  employeeId     String
  degree         String
  institution    String
  yearCompleted  Int?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])

  @@index([organizationId])
  @@index([employeeId])
  @@map("qualifications")
}

model TeacherProfile {
  id             String   @id @default(uuid())
  organizationId String
  employeeId     String   @unique
  bio            String?
  specialization String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])

  @@index([organizationId])
  @@map("teacher_profiles")
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Organization / tenancy hierarchy (plan §6 "Organization") ──────────────
// Organization → Campus → Faculty → Department → Program → AcademicYear →
// Term → Section, matching plan §4's stated hierarchy exactly. Phase 1
// modeled only the top two tiers; Phase 2 completes the rest.

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  campuses  Campus[]
  users     User[]
  roles     Role[]
  auditLogs AuditLog[]
  loginEvents LoginEvent[]
  accessPolicies AccessPolicy[]
  faculties      Faculty[]
  departments    Department[]
  programs       Program[]
  academicYears  AcademicYear[]
  terms          Term[]
  sections       Section[]
  staffTypes     StaffType[]
  designations   Designation[]
  employees      Employee[]
  employmentHistories EmploymentHistory[]
  qualifications      Qualification[]
  teacherProfiles     TeacherProfile[]
  subjects            Subject[]
  curricula           Curriculum[]
  curriculumSubjects  CurriculumSubject[]
  students            Student[]
  guardians           Guardian[]
  studentGuardians    StudentGuardian[]
  studentEnrollments  StudentEnrollment[]
  studentStatusHistories StudentStatusHistory[]
  admissionApplications AdmissionApplication[]
  admissionStatusHistories AdmissionStatusHistory[]

  @@map("organizations")
}

model Campus {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  userRoles    UserRole[]
  faculties    Faculty[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("campuses")
}

model Faculty {
  id             String   @id @default(uuid())
  organizationId String
  campusId       String
  name           String
  code           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  campus       Campus       @relation(fields: [campusId], references: [id])
  departments  Department[]

  @@unique([campusId, code])
  @@index([organizationId])
  @@map("faculties")
}

model Department {
  id             String   @id @default(uuid())
  organizationId String
  facultyId      String
  name           String
  code           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization        Organization        @relation(fields: [organizationId], references: [id])
  faculty             Faculty             @relation(fields: [facultyId], references: [id])
  programs            Program[]
  employees           Employee[]
  employmentHistories EmploymentHistory[]

  @@unique([facultyId, code])
  @@index([organizationId])
  @@map("departments")
}

model Program {
  id             String   @id @default(uuid())
  organizationId String
  departmentId   String
  name           String
  code           String
  // Free text, not an enum: institutions span schools (grades) and
  // colleges (degrees) with no fixed vocabulary — plan §1 explicitly
  // forbids hard-coding institution-specific structures like this.
  level          String?
  // Optional, generically applicable — not bachelor-specific despite
  // reading that way: a school program could set durationSemesters to
  // represent years just as validly. entranceExam is free text (e.g.
  // "IOST", "CMAT", "None"), never an enum of specific exam boards.
  durationSemesters Int?
  creditHours       Int?
  entranceExam      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  department   Department   @relation(fields: [departmentId], references: [id])
  sections     Section[]
  curricula    Curriculum[]
  studentEnrollments StudentEnrollment[]
  admissionApplications AdmissionApplication[]

  @@unique([departmentId, code])
  @@index([organizationId])
  @@map("programs")
}

// ── Academic (plan §6 "Academic", subjects/curriculum slice) ───────────────
// Subjects are an organization-wide catalog; a Curriculum names one
// subject *combination* for a Program (e.g. a school program has one
// curriculum, but a +2 Management program legitimately offers several
// distinct combinations — modeled as separate Curriculum rows under the
// same Program, not a single fixed list). Course/course_sections/
// teaching_assignments/class_schedules/rooms/periods (the
// scheduling-heavy remainder of plan §6 "Academic") are deferred to a
// later slice once Student enrollment exists to schedule around.

model Subject {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id])
  curriculumSubjects   CurriculumSubject[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("subjects")
}

model Curriculum {
  id             String   @id @default(uuid())
  organizationId String
  programId      String
  name           String
  code           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id])
  program      Program             @relation(fields: [programId], references: [id])
  subjects     CurriculumSubject[]

  @@unique([programId, code])
  @@index([organizationId])
  @@map("curricula")
}

model CurriculumSubject {
  id             String   @id @default(uuid())
  organizationId String
  curriculumId   String
  subjectId      String
  isCompulsory   Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  curriculum   Curriculum   @relation(fields: [curriculumId], references: [id])
  subject      Subject      @relation(fields: [subjectId], references: [id])

  @@unique([curriculumId, subjectId])
  @@index([organizationId])
  @@map("curriculum_subjects")
}

model AcademicYear {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  startDate      DateTime
  endDate        DateTime
  isCurrent      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  terms        Term[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("academic_years")
}

model Term {
  id             String   @id @default(uuid())
  organizationId String
  academicYearId String
  name           String
  code           String
  sequence       Int
  startDate      DateTime
  endDate        DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  sections     Section[]
  studentEnrollments StudentEnrollment[]

  @@unique([academicYearId, code])
  @@index([organizationId])
  @@map("terms")
}

model Section {
  id             String   @id @default(uuid())
  organizationId String
  programId      String
  termId         String
  name           String
  code           String
  capacity       Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  program      Program      @relation(fields: [programId], references: [id])
  term         Term         @relation(fields: [termId], references: [id])
  studentEnrollments StudentEnrollment[]

  @@unique([termId, programId, code])
  @@index([organizationId])
  @@map("sections")
}

// ── Security (plan §6 "Security" + §7 RBAC) ─────────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED
  DEACTIVATED
}

model User {
  id             String     @id @default(uuid())
  organizationId String
  email          String     @unique
  passwordHash   String
  firstName      String
  lastName       String
  status         UserStatus @default(INVITED)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  userRoles    UserRole[]
  sessions     Session[]
  loginEvents  LoginEvent[]
  auditLogs    AuditLog[]
  employee     Employee?
  student      Student?

  @@index([organizationId])
  @@map("users")
}

// System-defined role catalogue from plan §7. organizationId is null for
// the seeded system templates; an organization may in future clone one
// into an org-scoped custom role (out of scope for Phase 1).
model Role {
  id             String   @id @default(uuid())
  organizationId String?
  name           String
  description    String?
  isSystem       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization?    @relation(fields: [organizationId], references: [id])
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  // NB: Postgres treats NULL as distinct within a unique index, so this
  // constraint does not dedupe system roles (organizationId = null) —
  // only org-scoped custom roles. Seed script (prisma/seed.ts) handles
  // system-role idempotency with an explicit existence check instead.
  @@unique([organizationId, name])
  @@map("roles")
}

enum PermissionAction {
  VIEW
  CREATE
  UPDATE
  DELETE
  APPROVE
  EXPORT
  PRINT
  MANAGE
  ADMINISTER
}

model Permission {
  id          String            @id @default(uuid())
  resource    String
  action      PermissionAction
  description String?

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// A user's role assignment, optionally scoped to one campus. No campus
// scope = organization-wide (e.g. Org Admin).
model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  campusId  String?
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id])
  role   Role    @relation(fields: [roleId], references: [id])
  campus Campus? @relation(fields: [campusId], references: [id])

  @@unique([userId, roleId, campusId])
  @@index([userId])
  @@map("user_roles")
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

model LoginEvent {
  id             String   @id @default(uuid())
  organizationId String?
  userId         String?
  email          String
  success        Boolean
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@map("login_events")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  userId         String?
  action         String
  resource       String
  resourceId     String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([resource, resourceId])
  @@map("audit_logs")
}

model AccessPolicy {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  rules          Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name])
  @@map("access_policies")
}

// ── Staff (plan §6 "Staff") ──────────────────────────────────────────────
// teacher_subjects and staff_documents are deferred: the former needs
// Subject to exist (Academic structure, a later slice), the latter needs
// the Documents & Certificates domain (a later phase).

model StaffType {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  employees    Employee[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("staff_types")
}

model Designation {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id])
  employees           Employee[]
  employmentHistories EmploymentHistory[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("designations")
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

model Employee {
  id             String         @id @default(uuid())
  organizationId String
  // Set only for staff who also log in (teachers, admins, ...); many
  // support/non-teaching staff may never get a User account.
  userId         String?        @unique
  staffTypeId    String
  designationId  String
  departmentId   String?
  employeeCode   String
  firstName      String
  lastName       String
  email          String
  phone          String?
  dateOfJoining  DateTime
  status         EmployeeStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  organization      Organization        @relation(fields: [organizationId], references: [id])
  user               User?               @relation(fields: [userId], references: [id])
  staffType          StaffType           @relation(fields: [staffTypeId], references: [id])
  designation        Designation         @relation(fields: [designationId], references: [id])
  department         Department?         @relation(fields: [departmentId], references: [id])
  employmentHistory  EmploymentHistory[]
  qualifications     Qualification[]
  teacherProfile     TeacherProfile?

  @@unique([organizationId, employeeCode])
  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("employees")
}

model EmploymentHistory {
  id             String    @id @default(uuid())
  organizationId String
  employeeId     String
  designationId  String
  departmentId   String?
  startDate      DateTime
  endDate        DateTime?
  reason         String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])
  designation  Designation  @relation(fields: [designationId], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id])

  @@index([organizationId])
  @@index([employeeId])
  @@map("employment_history")
}

model Qualification {
  id             String   @id @default(uuid())
  organizationId String
  employeeId     String
  degree         String
  institution    String
  yearCompleted  Int?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])

  @@index([organizationId])
  @@index([employeeId])
  @@map("qualifications")
}

model TeacherProfile {
  id             String   @id @default(uuid())
  organizationId String
  employeeId     String   @unique
  bio            String?
  specialization String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])

  @@index([organizationId])
  @@map("teacher_profiles")
}

// ── Student (plan §6 "Student") ─────────────────────────────────────────────
// student_enrollments/student_programs/student_sections from the plan are
// collapsed into one StudentEnrollment table: which program, section and
// term a student is in for a given stretch is one coherent fact here, not
// three independently-varying ones — same "collapse when the shape is
// shared" call made for the org-hierarchy and staff slices. Deferred:
// student_addresses/student_photos/student_identifiers (no pressing need
// yet, easy to add as columns or tables later without a redesign) and
// student_documents (needs the Documents & Certificates domain, a later
// phase).

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  TRANSFERRED
  WITHDRAWN
}

model Student {
  id             String        @id @default(uuid())
  organizationId String
  // Set only if/when the student gets a portal login (plan §13 Student
  // dashboard) — not required for the administrative record to exist.
  userId         String?       @unique
  studentCode    String
  firstName      String
  lastName       String
  dateOfBirth    DateTime
  // Free text, not an enum — plan §1 forbids hard-coding
  // institution-specific vocabularies, and gender categories used on
  // admission forms vary by institution/jurisdiction.
  gender         String?
  status         StudentStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  organization  Organization        @relation(fields: [organizationId], references: [id])
  user          User?               @relation(fields: [userId], references: [id])
  guardians     StudentGuardian[]
  enrollments   StudentEnrollment[]
  statusHistory StudentStatusHistory[]
  admissionApplication AdmissionApplication?

  @@unique([organizationId, studentCode])
  @@index([organizationId])
  @@map("students")
}

model Guardian {
  id             String   @id @default(uuid())
  organizationId String
  firstName      String
  lastName       String
  phone          String
  email          String?
  occupation     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id])
  students     StudentGuardian[]

  @@index([organizationId])
  @@map("guardians")
}

model StudentGuardian {
  id               String   @id @default(uuid())
  organizationId   String
  studentId        String
  guardianId       String
  // Free text ("Father", "Mother", "Guardian", ...) — plan §1 again;
  // family structures aren't a fixed enum.
  relationship     String
  isPrimaryContact Boolean  @default(false)
  createdAt        DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id])
  guardian     Guardian     @relation(fields: [guardianId], references: [id])

  @@unique([studentId, guardianId])
  @@index([organizationId])
  @@map("student_guardians")
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  WITHDRAWN
}

model StudentEnrollment {
  id             String           @id @default(uuid())
  organizationId String
  studentId      String
  programId      String
  sectionId      String
  termId         String
  enrollmentDate DateTime
  status         EnrollmentStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id])
  program      Program      @relation(fields: [programId], references: [id])
  section      Section      @relation(fields: [sectionId], references: [id])
  term         Term         @relation(fields: [termId], references: [id])

  @@unique([studentId, termId])
  @@index([organizationId])
  @@map("student_enrollments")
}

model StudentStatusHistory {
  id             String        @id @default(uuid())
  organizationId String
  studentId      String
  status         StudentStatus
  reason         String?
  effectiveDate  DateTime
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id])

  @@index([organizationId])
  @@index([studentId])
  @@map("student_status_history")
}

// ── Admissions (plan §5 "Admissions") ───────────────────────────────────────
// A scoped-down first slice of the plan's full Admissions scope (online
// applications, document upload, review, scoring, entrance exams,
// interviews, merit lists, approval, admission fees, enrollment,
// configurable workflows): application intake, status review with an
// audit trail, and the enroll action that turns an approved application
// into a real Student + StudentEnrollment. Deferred: document upload
// (needs an object-storage decision, still an open item — see
// PHASE_1_NOTES.md), admission fees (needs the Finance domain), merit
// lists (a derived/computed view over applications, not its own data),
// configurable workflows (far beyond this slice).

enum AdmissionStatus {
  SUBMITTED
  UNDER_REVIEW
  INTERVIEW_SCHEDULED
  APPROVED
  REJECTED
  ENROLLED
}

model AdmissionApplication {
  id                  String          @id @default(uuid())
  organizationId      String
  programId           String
  applicantFirstName  String
  applicantLastName   String
  dateOfBirth         DateTime
  gender              String?
  guardianName        String?
  guardianPhone       String?
  appliedDate         DateTime
  status              AdmissionStatus @default(SUBMITTED)
  // Entrance-exam/interview score — a plain number, not tied to any
  // specific exam's scale (plan §1: don't hard-code institution-specific
  // structures).
  score               Float?
  notes                String?
  // Set only once the enroll action has run; the application row is kept
  // afterward as the historical record of how this student was admitted.
  enrolledStudentId   String?         @unique
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  organization    Organization           @relation(fields: [organizationId], references: [id])
  program         Program                @relation(fields: [programId], references: [id])
  enrolledStudent Student?               @relation(fields: [enrolledStudentId], references: [id])
  statusHistory   AdmissionStatusHistory[]

  @@index([organizationId])
  @@map("admission_applications")
}

model AdmissionStatusHistory {
  id             String          @id @default(uuid())
  organizationId String
  applicationId  String
  status         AdmissionStatus
  reason         String?
  effectiveDate  DateTime
  createdAt      DateTime        @default(now())

  organization Organization         @relation(fields: [organizationId], references: [id])
  application  AdmissionApplication @relation(fields: [applicationId], references: [id])

  @@index([organizationId])
  @@index([applicationId])
  @@map("admission_status_history")
}

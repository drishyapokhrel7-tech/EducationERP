generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Organization / tenancy hierarchy (plan §6 "Organization") ──────────────
// Organization → Campus → Faculty → Department → Program → AcademicYear →
// Term → Section, matching plan §4's stated hierarchy exactly. Phase 1
// modeled only the top two tiers; Phase 2 completes the rest.

// Licensing tier, set only by a PlatformAdmin (see that model below) —
// no self-service upgrade path exists yet, matching what was actually
// asked for (an operator-managed tier, not a billing/checkout flow).
// FREE/PROFESSIONAL's caps live in edition-limits.ts, not here — the
// two concrete numbers given don't need a full per-org-configurable
// schema.
enum Edition {
  FREE
  PROFESSIONAL
  ULTRA
}

model Organization {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  edition   Edition   @default(FREE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  campuses                    Campus[]
  users                       User[]
  roles                       Role[]
  auditLogs                   AuditLog[]
  loginEvents                 LoginEvent[]
  accessPolicies              AccessPolicy[]
  faculties                   Faculty[]
  departments                 Department[]
  programs                    Program[]
  academicYears               AcademicYear[]
  terms                       Term[]
  sections                    Section[]
  staffTypes                  StaffType[]
  designations                Designation[]
  employees                   Employee[]
  employmentHistories         EmploymentHistory[]
  qualifications              Qualification[]
  teacherProfiles             TeacherProfile[]
  subjects                    Subject[]
  curricula                   Curriculum[]
  curriculumSubjects          CurriculumSubject[]
  students                    Student[]
  guardians                   Guardian[]
  studentGuardians            StudentGuardian[]
  studentEnrollments          StudentEnrollment[]
  studentStatusHistories      StudentStatusHistory[]
  admissionApplications       AdmissionApplication[]
  admissionStatusHistories    AdmissionStatusHistory[]
  rooms                       Room[]
  periods                     Period[]
  teachingAssignments         TeachingAssignment[]
  classSchedules              ClassSchedule[]
  attendanceSessions          AttendanceSession[]
  studentAttendances          StudentAttendance[]
  staffAttendances            StaffAttendance[]
  attendanceExceptions        AttendanceException[]
  syllabi                     Syllabus[]
  syllabusNodes               SyllabusNode[]
  learningObjectives          LearningObjective[]
  lessonPlans                 LessonPlan[]
  classSessions               ClassSession[]
  classMaterials              ClassMaterial[]
  assignments                 Assignment[]
  assignmentSubmissions       AssignmentSubmission[]
  knowledgeChecks             KnowledgeCheck[]
  knowledgeCheckQuestions     KnowledgeCheckQuestion[]
  knowledgeCheckAttempts      KnowledgeCheckAttempt[]
  knowledgeCheckAnswers       KnowledgeCheckAnswer[]
  examTypes                   ExamType[]
  gradingSchemes              GradingScheme[]
  questionBanks               QuestionBank[]
  questions                   Question[]
  exams                       Exam[]
  examSubjects                ExamSubject[]
  examSchedules               ExamSchedule[]
  examRooms                   ExamRoom[]
  examAttempts                ExamAttempt[]
  marks                       Marks[]
  grades                      Grade[]
  reportCards                 ReportCard[]
  answers                     Answer[]
  biometricPolicy             BiometricPolicy?
  faceEnrollments             FaceEnrollment[]
  cameras                     Camera[]
  cameraEvents                CameraEvent[]
  faceEmbeddings              FaceEmbedding[]
  faceMatchEvents             FaceMatchEvent[]
  feeCategories               FeeCategory[]
  feeStructures               FeeStructure[]
  feeStructureItems           FeeStructureItem[]
  studentFeeAssignments       StudentFeeAssignment[]
  invoices                    Invoice[]
  invoiceItems                InvoiceItem[]
  payments                    Payment[]
  scholarships                Scholarship[]
  studentScholarships         StudentScholarship[]
  discounts                   Discount[]
  refunds                     Refund[]
  financialTransactions       FinancialTransaction[]
  esewaTransactions           EsewaTransaction[]
  leaveTypes                  LeaveType[]
  staffLeaveBalances          StaffLeaveBalance[]
  leaveRequests               LeaveRequest[]
  salaryStructures            SalaryStructure[]
  salaryStructureItems        SalaryStructureItem[]
  payrolls                    Payroll[]
  payrollItems                PayrollItem[]
  vehicles                    Vehicle[]
  drivers                     Driver[]
  routes                      Route[]
  stops                       Stop[]
  studentTransportAssignments StudentTransportAssignment[]
  vehicleTrackingEvents       VehicleTrackingEvent[]
  courseModules               CourseModule[]
  courseModuleItems           CourseModuleItem[]
  courseModuleItemCompletions CourseModuleItemCompletion[]
  announcements               Announcement[]
  discussionTopics            DiscussionTopic[]
  discussionPosts             DiscussionPost[]
  notifications               Notification[]
  hostels                     Hostel[]
  hostelBuildings             HostelBuilding[]
  hostelRooms                 HostelRoom[]
  hostelBeds                  HostelBed[]
  hostelAllocations           HostelAllocation[]
  hostelAttendance            HostelAttendance[]
  hostelVisitors              HostelVisitor[]
  hostelComplaints            HostelComplaint[]
  hostelMaintenanceRequests   HostelMaintenanceRequest[]
  hostelLookups               HostelLookup[]
  inventoryCategories         InventoryCategory[]
  suppliers                   Supplier[]
  inventoryItems              InventoryItem[]
  purchaseOrders              PurchaseOrder[]
  purchaseOrderItems          PurchaseOrderItem[]
  stockMovements              StockMovement[]
  assets                      Asset[]
  assetAssignments            AssetAssignment[]
  messageTemplates            MessageTemplate[]
  messages                    Message[]
  emailLogs                   EmailLog[]
  smsLogs                     SmsLog[]
  pushNotificationLogs        PushNotificationLog[]
  studentDocuments            StudentDocument[]
  staffDocuments              StaffDocument[]
  certificates                Certificate[]
  alumniProfiles              AlumniProfile[]
  alumniEducation             AlumniEducation[]
  alumniCompanies             AlumniCompany[]
  alumniCareerHistory         AlumniCareerHistory[]
  alumniSkills                AlumniSkill[]
  alumniCertifications        AlumniCertification[]
  alumniSurveys               AlumniSurvey[]
  alumniSurveyResponses       AlumniSurveyResponse[]
  alumniMentorships           AlumniMentorship[]
  alumniAchievements          AlumniAchievement[]
  careerOpportunities         CareerOpportunity[]
  careerApplications          CareerApplication[]
  careerServices              CareerService[]
  graduateOutcomes            GraduateOutcome[]

  @@map("organizations")
}

model Campus {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  code           String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  userRoles    UserRole[]
  faculties    Faculty[]
  rooms        Room[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("campuses")
}

model Faculty {
  id             String    @id @default(uuid())
  organizationId String
  campusId       String
  name           String
  code           String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  campus       Campus       @relation(fields: [campusId], references: [id])
  departments  Department[]

  @@unique([campusId, code])
  @@index([organizationId])
  @@map("faculties")
}

model Department {
  id             String    @id @default(uuid())
  organizationId String
  facultyId      String
  name           String
  code           String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization        Organization        @relation(fields: [organizationId], references: [id])
  faculty             Faculty             @relation(fields: [facultyId], references: [id])
  programs            Program[]
  employees           Employee[]
  employmentHistories EmploymentHistory[]

  @@unique([facultyId, code])
  @@index([organizationId])
  @@map("departments")
}

model Program {
  id                String    @id @default(uuid())
  organizationId    String
  departmentId      String
  name              String
  code              String
  // Free text, not an enum: institutions span schools (grades) and
  // colleges (degrees) with no fixed vocabulary — plan §1 explicitly
  // forbids hard-coding institution-specific structures like this.
  level             String?
  // Optional, generically applicable — not bachelor-specific despite
  // reading that way: a school program could set durationSemesters to
  // represent years just as validly. entranceExam is free text (e.g.
  // "IOST", "CMAT", "None"), never an enum of specific exam boards.
  durationSemesters Int?
  creditHours       Int?
  entranceExam      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  organization          Organization           @relation(fields: [organizationId], references: [id])
  department            Department             @relation(fields: [departmentId], references: [id])
  sections              Section[]
  curricula             Curriculum[]
  studentEnrollments    StudentEnrollment[]
  admissionApplications AdmissionApplication[]
  feeStructures         FeeStructure[]

  @@unique([departmentId, code])
  @@index([organizationId])
  @@map("programs")
}

// ── Academic (plan §6 "Academic", subjects/curriculum slice) ───────────────
// Subjects are an organization-wide catalog; a Curriculum names one
// subject *combination* for a Program (e.g. a school program has one
// curriculum, but a +2 Management program legitimately offers several
// distinct combinations — modeled as separate Curriculum rows under the
// same Program, not a single fixed list). Course/course_sections/
// teaching_assignments/class_schedules/rooms/periods (the
// scheduling-heavy remainder of plan §6 "Academic") are deferred to a
// later slice once Student enrollment exists to schedule around.

model Subject {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id])
  curriculumSubjects  CurriculumSubject[]
  teachingAssignments TeachingAssignment[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("subjects")
}

model Curriculum {
  id             String   @id @default(uuid())
  organizationId String
  programId      String
  name           String
  code           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id])
  program      Program             @relation(fields: [programId], references: [id])
  subjects     CurriculumSubject[]

  @@unique([programId, code])
  @@index([organizationId])
  @@map("curricula")
}

model CurriculumSubject {
  id             String   @id @default(uuid())
  organizationId String
  curriculumId   String
  subjectId      String
  isCompulsory   Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization  Organization   @relation(fields: [organizationId], references: [id])
  curriculum    Curriculum     @relation(fields: [curriculumId], references: [id])
  subject       Subject        @relation(fields: [subjectId], references: [id])
  syllabi       Syllabus[]
  questionBanks QuestionBank[]
  examSubjects  ExamSubject[]

  @@unique([curriculumId, subjectId])
  @@index([organizationId])
  @@map("curriculum_subjects")
}

model AcademicYear {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  startDate      DateTime
  endDate        DateTime
  isCurrent      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  terms        Term[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("academic_years")
}

model Term {
  id             String   @id @default(uuid())
  organizationId String
  academicYearId String
  name           String
  code           String
  sequence       Int
  startDate      DateTime
  endDate        DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id])
  academicYear        AcademicYear         @relation(fields: [academicYearId], references: [id])
  sections            Section[]
  studentEnrollments  StudentEnrollment[]
  teachingAssignments TeachingAssignment[]
  classSchedules      ClassSchedule[]
  syllabi             Syllabus[]
  exams               Exam[]
  feeStructures       FeeStructure[]

  @@unique([academicYearId, code])
  @@index([organizationId])
  @@map("terms")
}

model Section {
  id             String    @id @default(uuid())
  organizationId String
  programId      String
  termId         String
  name           String
  code           String
  capacity       Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization        Organization         @relation(fields: [organizationId], references: [id])
  program             Program              @relation(fields: [programId], references: [id])
  term                Term                 @relation(fields: [termId], references: [id])
  studentEnrollments  StudentEnrollment[]
  teachingAssignments TeachingAssignment[]
  classSchedules      ClassSchedule[]
  attendanceSessions  AttendanceSession[]
  classSessions       ClassSession[]

  @@unique([termId, programId, code])
  @@index([organizationId])
  @@map("sections")
}

// ── Security (plan §6 "Security" + §7 RBAC) ─────────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED
  DEACTIVATED
}

model User {
  id              String     @id @default(uuid())
  organizationId  String
  email           String     @unique
  // Set for self-service logins that aren't email-based (students log in
  // by student code, not email) — `{organizationSlug}.{studentCode}`,
  // globally unique the same way email is, so login can look up either
  // column with one identifier field.
  username        String?    @unique
  passwordHash    String
  firstName       String
  lastName        String
  status          UserStatus @default(INVITED)
  // Null = not verified. Registration creates the account ACTIVE
  // immediately (unchanged) — this is a non-blocking, after-the-fact
  // confirmation, not a login gate. See EmailVerificationCode.
  emailVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  organization               Organization            @relation(fields: [organizationId], references: [id])
  userRoles                  UserRole[]
  sessions                   Session[]
  loginEvents                LoginEvent[]
  emailVerificationCodes     EmailVerificationCode[]
  passwordResetCodes         PasswordResetCode[]
  auditLogs                  AuditLog[]
  employee                   Employee?
  student                    Student?
  faceMatchReviews           FaceMatchEvent[]
  feeAssignments             StudentFeeAssignment[]
  paymentsRecorded           Payment[]
  discountsApplied           Discount[]
  refundsProcessed           Refund[]
  esewaTransactionsInitiated EsewaTransaction[]
  leaveRequestsReviewed      LeaveRequest[]
  payrollsFinalized          Payroll[]
  notifications              Notification[]
  messagesCreated            Message[]               @relation("MessagesCreated")
  messagesReceivedDirectly   Message[]               @relation("MessagesToSpecificUser")
  pushNotificationLogs       PushNotificationLog[]   @relation("PushLogsToUser")
  studentDocumentsReviewed   StudentDocument[]       @relation("StudentDocumentsReviewed")
  staffDocumentsReviewed     StaffDocument[]         @relation("StaffDocumentsReviewed")
  certificatesIssued         Certificate[]           @relation("CertificatesIssued")

  @@index([organizationId])
  @@map("users")
}

// System-defined role catalogue from plan §7. organizationId is null for
// the seeded system templates; an organization may in future clone one
// into an org-scoped custom role (out of scope for Phase 1).
model Role {
  id             String   @id @default(uuid())
  organizationId String?
  name           String
  description    String?
  isSystem       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization?    @relation(fields: [organizationId], references: [id])
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  // NB: Postgres treats NULL as distinct within a unique index, so this
  // constraint does not dedupe system roles (organizationId = null) —
  // only org-scoped custom roles. Seed script (prisma/seed.ts) handles
  // system-role idempotency with an explicit existence check instead.
  @@unique([organizationId, name])
  @@map("roles")
}

enum PermissionAction {
  VIEW
  CREATE
  UPDATE
  DELETE
  APPROVE
  EXPORT
  PRINT
  MANAGE
  ADMINISTER
}

model Permission {
  id          String           @id @default(uuid())
  resource    String
  action      PermissionAction
  description String?

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// A user's role assignment, optionally scoped to one campus. No campus
// scope = organization-wide (e.g. Org Admin).
model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  campusId  String?
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id])
  role   Role    @relation(fields: [roleId], references: [id])
  campus Campus? @relation(fields: [campusId], references: [id])

  @@unique([userId, roleId, campusId])
  @@index([userId])
  @@map("user_roles")
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

// No real email provider exists in this project (see
// EmailVerificationService's own comment) — the code is shown
// directly in the UI, not sent, so this is a self-verification step
// confirming the user can read a code back, not proof of inbox
// ownership. Same single-use/expiring/hashed shape as Captcha, keyed
// by userId instead of being anonymous/global. Not RLS-protected —
// same reasoning as Session/LoginEvent (auth-adjacent, reached before
// a tenant context is meaningful for this kind of lookup).
model EmailVerificationCode {
  id         String    @id @default(uuid())
  userId     String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("email_verification_codes")
}

// Deliberately a separate table from EmailVerificationCode, not a
// shared "purpose" column on one generic OTP table — same "one
// concern, one table" precedent as Captcha vs this vs that: a leak or
// bug in one code type can never accidentally become valid for
// another. Same shape/lifecycle (Postgres-backed, single-use,
// expiring, argon2-hashed) — see PasswordResetService's own comment
// for why the code is shown on-screen here too, not emailed. Not
// RLS-protected — same reasoning as Session/LoginEvent/
// EmailVerificationCode: this is reached before a tenant context is
// meaningful (the user isn't logged in yet).
model PasswordResetCode {
  id         String    @id @default(uuid())
  userId     String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_reset_codes")
}

model LoginEvent {
  id             String   @id @default(uuid())
  organizationId String?
  userId         String?
  email          String
  success        Boolean
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@map("login_events")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  userId         String?
  action         String
  resource       String
  resourceId     String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([resource, resourceId])
  // Append-only, ever-growing table; every real query on it (audit
  // trail views, future retention jobs) filters by date range.
  @@index([createdAt])
  @@map("audit_logs")
}

model AccessPolicy {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  rules          Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name])
  @@map("access_policies")
}

// ── Staff (plan §6 "Staff") ──────────────────────────────────────────────
// teacher_subjects and staff_documents are deferred: the former needs
// Subject to exist (Academic structure, a later slice), the latter needs
// the Documents & Certificates domain (a later phase).

model StaffType {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  employees    Employee[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("staff_types")
}

model Designation {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization        Organization        @relation(fields: [organizationId], references: [id])
  employees           Employee[]
  employmentHistories EmploymentHistory[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("designations")
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

model Employee {
  id                String         @id @default(uuid())
  organizationId    String
  // Set only for staff who also log in (teachers, admins, ...); many
  // support/non-teaching staff may never get a User account.
  userId            String?        @unique
  staffTypeId       String
  designationId     String
  departmentId      String?
  employeeCode      String
  firstName         String
  lastName          String
  email             String
  phone             String?
  dateOfJoining     DateTime
  status            EmployeeStatus @default(ACTIVE)
  // Same generic-storage-URL field and reasoning as Student.photoUrl.
  photoUrl          String?
  // The employee's *current* compensation template (Phase 7 slice
  // 7b-2) — a raise just repoints this FK; past Payroll rows already
  // snapshotted their items and are never retroactively affected.
  salaryStructureId String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?

  organization            Organization         @relation(fields: [organizationId], references: [id])
  user                    User?                @relation(fields: [userId], references: [id])
  staffType               StaffType            @relation(fields: [staffTypeId], references: [id])
  designation             Designation          @relation(fields: [designationId], references: [id])
  department              Department?          @relation(fields: [departmentId], references: [id])
  salaryStructure         SalaryStructure?     @relation(fields: [salaryStructureId], references: [id])
  employmentHistory       EmploymentHistory[]
  qualifications          Qualification[]
  teacherProfile          TeacherProfile?
  teachingAssignments     TeachingAssignment[]
  classSchedulesAsTeacher ClassSchedule[]
  staffAttendances        StaffAttendance[]
  faceEnrollments         FaceEnrollment[]
  leaveBalances           StaffLeaveBalance[]
  leaveRequests           LeaveRequest[]
  payrolls                Payroll[]
  driverProfile           Driver?
  routesAsDriver          Route[]              @relation("routesAsDriver")
  discussionPosts         DiscussionPost[]
  assetAssignments        AssetAssignment[]
  documents               StaffDocument[]

  @@unique([organizationId, employeeCode])
  @@unique([organizationId, email])
  @@index([organizationId])
  // Filtered on directly by service-layer queries but weren't covered
  // by any index — Phase 8 performance-optimization slice.
  @@index([departmentId])
  @@index([designationId])
  @@index([staffTypeId])
  @@map("employees")
}

model EmploymentHistory {
  id             String    @id @default(uuid())
  organizationId String
  employeeId     String
  designationId  String
  departmentId   String?
  startDate      DateTime
  endDate        DateTime?
  reason         String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])
  designation  Designation  @relation(fields: [designationId], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id])

  @@index([organizationId])
  @@index([employeeId])
  @@map("employment_history")
}

model Qualification {
  id             String   @id @default(uuid())
  organizationId String
  employeeId     String
  degree         String
  institution    String
  yearCompleted  Int?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])

  @@index([organizationId])
  @@index([employeeId])
  @@map("qualifications")
}

model TeacherProfile {
  id             String   @id @default(uuid())
  organizationId String
  employeeId     String   @unique
  bio            String?
  specialization String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])

  @@index([organizationId])
  @@map("teacher_profiles")
}

// ── Student (plan §6 "Student") ─────────────────────────────────────────────
// student_enrollments/student_programs/student_sections from the plan are
// collapsed into one StudentEnrollment table: which program, section and
// term a student is in for a given stretch is one coherent fact here, not
// three independently-varying ones — same "collapse when the shape is
// shared" call made for the org-hierarchy and staff slices. Deferred:
// student_addresses/student_photos/student_identifiers (no pressing need
// yet, easy to add as columns or tables later without a redesign) and
// student_documents (needs the Documents & Certificates domain, a later
// phase).

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  TRANSFERRED
  WITHDRAWN
}

model Student {
  id             String        @id @default(uuid())
  organizationId String
  // Set only if/when the student gets a portal login (plan §13 Student
  // dashboard) — not required for the administrative record to exist.
  userId         String?       @unique
  studentCode    String
  firstName      String
  lastName       String
  dateOfBirth    DateTime
  // Free text, not an enum — plan §1 forbids hard-coding
  // institution-specific vocabularies, and gender categories used on
  // admission forms vary by institution/jurisdiction.
  gender         String?
  status         StudentStatus @default(ACTIVE)
  // A storage URL (whatever STORAGE_DRIVER is configured — local disk,
  // S3, or Google Drive, LMS discovery slice 8), set via the same
  // generic upload endpoint every other file-attaching field in this
  // project already uses — not a dedicated photo pipeline. Distinct
  // from FaceEnrollment's own photo (Phase 6a/6c): that one is
  // consent-gated, kept only for uncertain biometric matches, and
  // governed by BiometricPolicy's retention window; this is a plain,
  // always-visible identification photo on the student record, same
  // as any other administrative field.
  photoUrl       String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  organization                Organization                 @relation(fields: [organizationId], references: [id])
  user                        User?                        @relation(fields: [userId], references: [id])
  guardians                   StudentGuardian[]
  enrollments                 StudentEnrollment[]
  statusHistory               StudentStatusHistory[]
  admissionApplication        AdmissionApplication?
  attendanceRecords           StudentAttendance[]
  assignmentSubmissions       AssignmentSubmission[]
  knowledgeCheckAttempts      KnowledgeCheckAttempt[]
  examAttempts                ExamAttempt[]
  reportCards                 ReportCard[]
  faceEnrollments             FaceEnrollment[]
  invoices                    Invoice[]
  scholarships                StudentScholarship[]
  courseModuleItemCompletions CourseModuleItemCompletion[]
  discussionPosts             DiscussionPost[]
  documents                   StudentDocument[]
  certificates                Certificate[]
  alumniProfile               AlumniProfile?
  alumniMentorships           AlumniMentorship[]
  careerApplications          CareerApplication[]

  @@unique([organizationId, studentCode])
  @@index([organizationId])
  @@map("students")
}

model Guardian {
  id             String   @id @default(uuid())
  organizationId String
  firstName      String
  lastName       String
  phone          String
  email          String?
  occupation     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id])
  students     StudentGuardian[]

  @@index([organizationId])
  @@map("guardians")
}

model StudentGuardian {
  id               String   @id @default(uuid())
  organizationId   String
  studentId        String
  guardianId       String
  // Free text ("Father", "Mother", "Guardian", ...) — plan §1 again;
  // family structures aren't a fixed enum.
  relationship     String
  isPrimaryContact Boolean  @default(false)
  createdAt        DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id])
  guardian     Guardian     @relation(fields: [guardianId], references: [id])

  @@unique([studentId, guardianId])
  @@index([organizationId])
  @@map("student_guardians")
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  WITHDRAWN
}

model StudentEnrollment {
  id             String           @id @default(uuid())
  organizationId String
  studentId      String
  programId      String
  sectionId      String
  termId         String
  enrollmentDate DateTime
  status         EnrollmentStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization        Organization                @relation(fields: [organizationId], references: [id])
  student             Student                     @relation(fields: [studentId], references: [id])
  program             Program                     @relation(fields: [programId], references: [id])
  section             Section                     @relation(fields: [sectionId], references: [id])
  term                Term                        @relation(fields: [termId], references: [id])
  invoices            Invoice[]
  feeAssignments      StudentFeeAssignment[]
  transportAssignment StudentTransportAssignment?
  hostelAllocation    HostelAllocation?

  @@unique([studentId, termId])
  @@index([organizationId])
  @@map("student_enrollments")
}

model StudentStatusHistory {
  id             String        @id @default(uuid())
  organizationId String
  studentId      String
  status         StudentStatus
  reason         String?
  effectiveDate  DateTime
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id])

  @@index([organizationId])
  @@index([studentId])
  @@map("student_status_history")
}

// ── Admissions (plan §5 "Admissions") ───────────────────────────────────────
// A scoped-down first slice of the plan's full Admissions scope (online
// applications, document upload, review, scoring, entrance exams,
// interviews, merit lists, approval, admission fees, enrollment,
// configurable workflows): application intake, status review with an
// audit trail, and the enroll action that turns an approved application
// into a real Student + StudentEnrollment. Deferred: document upload
// (needs an object-storage decision, still an open item — see
// PHASE_1_NOTES.md), admission fees (needs the Finance domain), merit
// lists (a derived/computed view over applications, not its own data),
// configurable workflows (far beyond this slice).

enum AdmissionStatus {
  SUBMITTED
  UNDER_REVIEW
  INTERVIEW_SCHEDULED
  APPROVED
  REJECTED
  ENROLLED
}

model AdmissionApplication {
  id                 String          @id @default(uuid())
  organizationId     String
  programId          String
  applicantFirstName String
  applicantLastName  String
  dateOfBirth        DateTime
  gender             String?
  guardianName       String?
  guardianPhone      String?
  appliedDate        DateTime
  status             AdmissionStatus @default(SUBMITTED)
  // Entrance-exam/interview score — a plain number, not tied to any
  // specific exam's scale (plan §1: don't hard-code institution-specific
  // structures).
  score              Float?
  notes              String?
  // Set only once the enroll action has run; the application row is kept
  // afterward as the historical record of how this student was admitted.
  enrolledStudentId  String?         @unique
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  organization    Organization             @relation(fields: [organizationId], references: [id])
  program         Program                  @relation(fields: [programId], references: [id])
  enrolledStudent Student?                 @relation(fields: [enrolledStudentId], references: [id])
  statusHistory   AdmissionStatusHistory[]

  @@index([organizationId])
  @@map("admission_applications")
}

model AdmissionStatusHistory {
  id             String          @id @default(uuid())
  organizationId String
  applicationId  String
  status         AdmissionStatus
  reason         String?
  effectiveDate  DateTime
  createdAt      DateTime        @default(now())

  organization Organization         @relation(fields: [organizationId], references: [id])
  application  AdmissionApplication @relation(fields: [applicationId], references: [id])

  @@index([organizationId])
  @@index([applicationId])
  @@map("admission_status_history")
}

// ── Timetable & Scheduling (plan §6 "Academic": rooms, periods,
// teaching_assignments, class_schedules — Phase 3 slice 3a) ────────────────
// Section/Program/Term/Subject/Employee already exist from Phase 2; this
// slice is the first piece of Phase 3 (Teaching, Learning, Timetable &
// Attendance) and everything else in that phase (syllabus, lesson plans,
// class sessions, "My Classes Today") is built on top of the weekly
// schedule this establishes.

model Room {
  id             String    @id @default(uuid())
  organizationId String
  campusId       String
  name           String
  code           String
  capacity       Int?
  // Free text, not an enum — same reasoning as Program.level: room
  // taxonomies (classroom/lab/auditorium/workshop) vary by institution
  // type and plan §1 forbids hard-coding this kind of vocabulary.
  roomType       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization   Organization    @relation(fields: [organizationId], references: [id])
  campus         Campus          @relation(fields: [campusId], references: [id])
  classSchedules ClassSchedule[]
  examRooms      ExamRoom[]

  @@unique([campusId, code])
  @@index([organizationId])
  @@map("rooms")
}

model Period {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String
  // Ordering within a day (Period 1, Period 2, ...) — display only, not
  // used for conflict checks (dayOfWeek + periodId does that).
  sequence       Int
  // "HH:mm" 24-hour strings, not a Time/DateTime column — a period is a
  // recurring daily slot with no date component, and Postgres's `time`
  // type doesn't map to a native Prisma scalar without extra tooling.
  startTime      String
  endTime        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id])
  classSchedules ClassSchedule[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("periods")
}

model TeachingAssignment {
  id             String   @id @default(uuid())
  organizationId String
  employeeId     String
  subjectId      String
  sectionId      String
  termId         String
  createdAt      DateTime @default(now())

  organization     Organization      @relation(fields: [organizationId], references: [id])
  employee         Employee          @relation(fields: [employeeId], references: [id])
  subject          Subject           @relation(fields: [subjectId], references: [id])
  section          Section           @relation(fields: [sectionId], references: [id])
  term             Term              @relation(fields: [termId], references: [id])
  classSchedules   ClassSchedule[]
  lessonPlans      LessonPlan[]
  assignments      Assignment[]
  knowledgeChecks  KnowledgeCheck[]
  courseModules    CourseModule[]
  announcements    Announcement[]
  discussionTopics DiscussionTopic[]

  // One teacher per subject+section+term — re-assigning means changing
  // this row, not stacking a second one alongside it.
  @@unique([sectionId, subjectId, termId])
  @@index([organizationId])
  @@map("teaching_assignments")
}

model ClassSchedule {
  id                   String   @id @default(uuid())
  organizationId       String
  termId               String
  teachingAssignmentId String
  // sectionId and teacherId are denormalized off teachingAssignment
  // (not just a convenience) — Postgres unique constraints need real
  // columns to enforce "no double-booking" at the database level, not
  // just in application code, the same reasoning every prior slice
  // applied to FK-vs-RLS parent guards.
  sectionId            String
  teacherId            String
  roomId               String
  periodId             String
  // 1=Monday .. 7=Sunday (ISO 8601), not an enum — day-name vocabularies
  // and week structures vary by institution/locale (plan §1).
  dayOfWeek            Int
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id])
  term               Term                @relation(fields: [termId], references: [id])
  teachingAssignment TeachingAssignment  @relation(fields: [teachingAssignmentId], references: [id])
  section            Section             @relation(fields: [sectionId], references: [id])
  teacher            Employee            @relation(fields: [teacherId], references: [id])
  room               Room                @relation(fields: [roomId], references: [id])
  period             Period              @relation(fields: [periodId], references: [id])
  attendanceSessions AttendanceSession[]
  classSessions      ClassSession[]

  @@unique([termId, roomId, dayOfWeek, periodId], map: "class_schedules_room_slot_key")
  @@unique([termId, sectionId, dayOfWeek, periodId], map: "class_schedules_section_slot_key")
  @@unique([termId, teacherId, dayOfWeek, periodId], map: "class_schedules_teacher_slot_key")
  @@index([organizationId])
  @@map("class_schedules")
}

// ── Attendance (plan §6 "Attendance" — Phase 3 slice 3b) ────────────────────
// Scoped to manual/session-based attendance only: attendance_devices,
// attendance_events and entry_exit_records (the automated-capture side of
// plan §6's Attendance group) belong with Phase 6 (CCTV/Biometric), where
// the capture hardware/pipeline that would ever populate them actually
// gets built — building those tables now would just be unused schema.

model AttendanceSession {
  id              String   @id @default(uuid())
  organizationId  String
  classScheduleId String
  // Denormalized off classSchedule — same reasoning as ClassSchedule's own
  // sectionId/teacherId: the roster query and the one-session-per-slot-
  // per-day uniqueness both need a real column, not a join.
  sectionId       String
  date            DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization      Organization        @relation(fields: [organizationId], references: [id])
  classSchedule     ClassSchedule       @relation(fields: [classScheduleId], references: [id])
  section           Section             @relation(fields: [sectionId], references: [id])
  studentAttendance StudentAttendance[]

  @@unique([classScheduleId, date])
  @@index([organizationId])
  @@map("attendance_sessions")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model StudentAttendance {
  id                  String           @id @default(uuid())
  organizationId      String
  attendanceSessionId String
  studentId           String
  status              AttendanceStatus
  remarks             String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  organization         Organization          @relation(fields: [organizationId], references: [id])
  session              AttendanceSession     @relation(fields: [attendanceSessionId], references: [id])
  student              Student               @relation(fields: [studentId], references: [id])
  exceptions           AttendanceException[]
  reconciledFromEvents FaceMatchEvent[]

  @@unique([attendanceSessionId, studentId])
  @@index([organizationId])
  // Student-dashboard reads query by studentId alone (not through the
  // unique's leading attendanceSessionId) — Phase 8 performance slice.
  @@index([studentId])
  @@map("student_attendance")
}

// A correction's audit trail — every status change after the initial mark
// (made via the bulk mark action, not this model) is recorded here with a
// reason, same pattern as StudentStatusHistory/AdmissionStatusHistory.
model AttendanceException {
  id                  String           @id @default(uuid())
  organizationId      String
  studentAttendanceId String
  previousStatus      AttendanceStatus
  newStatus           AttendanceStatus
  reason              String
  createdAt           DateTime         @default(now())

  organization      Organization      @relation(fields: [organizationId], references: [id])
  studentAttendance StudentAttendance @relation(fields: [studentAttendanceId], references: [id])

  @@index([organizationId])
  @@index([studentAttendanceId])
  @@map("attendance_exceptions")
}

enum StaffAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  ON_LEAVE
  HALF_DAY
}

model StaffAttendance {
  id             String                @id @default(uuid())
  organizationId String
  employeeId     String
  date           DateTime
  status         StaffAttendanceStatus
  remarks        String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization         Organization     @relation(fields: [organizationId], references: [id])
  employee             Employee         @relation(fields: [employeeId], references: [id])
  reconciledFromEvents FaceMatchEvent[]

  @@unique([employeeId, date])
  @@index([organizationId])
  @@map("staff_attendance")
}

// ── CCTV / Biometric — privacy & consent foundation (plan §6/§11/§12 —
// Phase 6 slice 6a) ──────────────────────────────────────────────────────
// This slice is deliberately capability-free: no face image, embedding,
// camera, or matching model exists yet (those are slices 6b/6c, once the
// pipeline that would populate them actually exists — same "don't build
// unused schema" reasoning as Answer being deferred until slice 4f).
// What's here is the privacy/consent boundary that has to exist *before*
// any of that: an org-wide disable switch (BiometricPolicy, absent-by-
// default so "off" is the fail-safe with zero setup) and a per-person
// consent record (FaceEnrollment) — no student or staff member is ever
// enrolled by the institution-level toggle alone, only by their own (or a
// guardian's) explicit recorded consent.

model BiometricPolicy {
  id                       String   @id @default(uuid())
  organizationId           String   @unique
  enabled                  Boolean  @default(false)
  retentionDays            Int      @default(365)
  matchConfidenceThreshold Float    @default(0.75)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("biometric_policies")
}

enum FaceEnrollmentStatus {
  ACTIVE
  WITHDRAWN
}

model FaceEnrollment {
  id                 String               @id @default(uuid())
  organizationId     String
  // Exactly one of these two is set — the plan's ERD names one shared
  // face_enrollments table (unlike this project's own Attendance
  // precedent, which splits Student/Staff into separate tables), so a
  // single table is followed here, but via two typed nullable FKs rather
  // than an untyped personId+personType pair, keeping real FK integrity.
  // The XOR is enforced at the service layer, the same way this project
  // already enforces "exactly one" invariants that Postgres constraints
  // don't conveniently express.
  studentId          String?
  staffId            String?
  status             FaceEnrollmentStatus @default(ACTIVE)
  consentGivenAt     DateTime
  // Who actually gave consent — "self" or a guardian's name — not just
  // that consent exists, since that's what an audit of this data would
  // need to answer.
  consentGivenBy     String
  consentWithdrawnAt DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  organization  Organization     @relation(fields: [organizationId], references: [id])
  student       Student?         @relation(fields: [studentId], references: [id])
  staff         Employee?        @relation(fields: [staffId], references: [id])
  faceEmbedding FaceEmbedding?
  matchEvents   FaceMatchEvent[]

  @@index([organizationId])
  @@index([studentId])
  @@index([staffId])
  @@map("face_enrollments")
}

// ── CCTV / Biometric — camera capture, matching, human review (Phase 6
// slice 6c) ──────────────────────────────────────────────────────────────
// Where 6a's consent and 6b's embedding service actually connect.
// FaceEmbedding is only ever created via the enrollment-photo endpoint
// (a deliberately-empty table until now, same "don't build unused
// schema" reasoning already applied to Answer/FaceEnrollment). A
// captured frame's image is discarded immediately for a confidently
// IDENTIFIED result and kept only for POSSIBLE_MATCH/UNKNOWN, so a
// human reviewer has something to look at — confirmed with the user
// before this slice was planned, governed by BiometricPolicy's
// retentionDays (an automated purge job is a deliberate follow-up, not
// built here).

enum CameraAdapterType {
  SIMULATED
  RTSP
  USB_WEBCAM
}

enum CameraStatus {
  ACTIVE
  INACTIVE
}

model Camera {
  id             String            @id @default(uuid())
  organizationId String
  name           String
  location       String?
  // Descriptive metadata only — this backend never actually connects
  // to a camera regardless of type, it only receives already-captured
  // frames over HTTP. Real adapter behavior (RTSP polling, etc.)
  // belongs to a future client (slice 6e), not this table.
  adapterType    CameraAdapterType @default(SIMULATED)
  status         CameraStatus      @default(ACTIVE)
  // Camera health (slice 6e): set on every successful ingestEvent
  // write, regardless of whether a face was detected — a capture
  // client posts on its regular interval either way, so this is a
  // natural heartbeat with no separate endpoint needed. "Healthy" vs
  // "stale" is computed on read (client-side), not stored, same
  // reasoning already applied to syllabus_progress elsewhere.
  lastSeenAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  events       CameraEvent[]

  @@index([organizationId])
  @@map("cameras")
}

model CameraEvent {
  id                String   @id @default(uuid())
  organizationId    String
  cameraId          String
  capturedAt        DateTime @default(now())
  // Null unless at least one detected face in this frame came back
  // POSSIBLE_MATCH or UNKNOWN — see the retention note above.
  capturedImage     Bytes?
  capturedImageType String?
  createdAt         DateTime @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id])
  camera       Camera           @relation(fields: [cameraId], references: [id])
  matches      FaceMatchEvent[]

  @@index([organizationId])
  @@index([cameraId])
  @@map("camera_events")
}

model FaceEmbedding {
  id               String                     @id @default(uuid())
  organizationId   String
  faceEnrollmentId String                     @unique
  // Prisma has no native vector type — Unsupported() still generates
  // the column via migration SQL, but reads/writes go through
  // $queryRaw/$executeRaw (verified directly against this project's
  // real Neon database before this slice was planned: an uncast read
  // throws a deserialization error, an explicit ::text cast works,
  // and the <=> cosine-distance operator ranks correctly).
  embedding        Unsupported("vector(512)")
  // Which FACE_MODEL_NAME produced this embedding — future model
  // changes need to know which rows are stale.
  modelVersion     String
  createdAt        DateTime                   @default(now())

  organization   Organization   @relation(fields: [organizationId], references: [id])
  faceEnrollment FaceEnrollment @relation(fields: [faceEnrollmentId], references: [id])

  @@index([organizationId])
  @@map("face_embeddings")
}

enum FaceMatchResult {
  IDENTIFIED
  POSSIBLE_MATCH
  UNKNOWN
}

enum FaceMatchReviewDecision {
  CONFIRMED
  REJECTED
}

model FaceMatchEvent {
  id                            String                   @id @default(uuid())
  organizationId                String
  cameraEventId                 String
  matchedEnrollmentId           String?
  confidence                    Float
  result                        FaceMatchResult
  // The architecture doc's explicit "human review for uncertain
  // matches" requirement — only ever set for a POSSIBLE_MATCH.
  reviewedAt                    DateTime?
  reviewedBy                    String?
  reviewDecision                FaceMatchReviewDecision?
  // Attendance reconciliation (Phase 6 slice 6d) — set only when this
  // exact match event is what caused a StudentAttendance/StaffAttendance
  // row to be created (never on a row that already existed; "augments,
  // never replaces" per the architecture doc). Mutually exclusive,
  // mirroring FaceEnrollment's own studentId/staffId XOR. Deliberately
  // no separate attendance_events/entry_exit_records table — this row
  // already is that record.
  reconciledStudentAttendanceId String?
  reconciledStaffAttendanceId   String?
  createdAt                     DateTime                 @default(now())

  organization                Organization       @relation(fields: [organizationId], references: [id])
  cameraEvent                 CameraEvent        @relation(fields: [cameraEventId], references: [id])
  matchedEnrollment           FaceEnrollment?    @relation(fields: [matchedEnrollmentId], references: [id])
  reviewer                    User?              @relation(fields: [reviewedBy], references: [id])
  reconciledStudentAttendance StudentAttendance? @relation(fields: [reconciledStudentAttendanceId], references: [id])
  reconciledStaffAttendance   StaffAttendance?   @relation(fields: [reconciledStaffAttendanceId], references: [id])

  @@index([organizationId])
  @@index([cameraEventId])
  @@map("face_match_events")
}

// ── Syllabus & Lesson Plans (plan §6 "Teaching & Learning" — Phase 3
// slice 3c) ──────────────────────────────────────────────────────────────
// syllabus_versions is deliberately not modeled — no revision-history
// requirement has been specified yet (same "defer until asked" reasoning
// every prior slice has applied to unspecified scope); Syllabus is
// directly editable, the same way Program/Subject are.
//
// unit/chapter/topic/subtopic collapse into one self-referencing tree
// (SyllabusNode + a level marker) instead of four near-identical tables —
// same reasoning as StudentEnrollment's and ClassSchedule's earlier
// collapses: all four are the same shape (ordered, named, nested under a
// parent). The four-level enum itself is a property of this workflow
// (plan §8 names exactly these four levels), not an institution-specific
// taxonomy plan §1 forbids hard-coding, so an enum is appropriate here
// unlike e.g. Room.roomType.

model Syllabus {
  id                  String   @id @default(uuid())
  organizationId      String
  curriculumSubjectId String
  termId              String
  name                String?
  description         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization      Organization      @relation(fields: [organizationId], references: [id])
  curriculumSubject CurriculumSubject @relation(fields: [curriculumSubjectId], references: [id])
  term              Term              @relation(fields: [termId], references: [id])
  nodes             SyllabusNode[]

  // One syllabus per curriculum-subject+term — revising means editing
  // this row's nodes, not creating a second syllabus alongside it.
  @@unique([curriculumSubjectId, termId])
  @@index([organizationId])
  @@map("syllabi")
}

enum SyllabusNodeLevel {
  UNIT
  CHAPTER
  TOPIC
  SUBTOPIC
}

model SyllabusNode {
  id             String            @id @default(uuid())
  organizationId String
  syllabusId     String
  parentId       String?
  level          SyllabusNodeLevel
  // Ordering among siblings under the same parent (or top-level within
  // the syllabus for UNIT nodes) — display only.
  sequence       Int
  name           String
  description    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id])
  syllabus           Syllabus            @relation(fields: [syllabusId], references: [id])
  parent             SyllabusNode?       @relation("SyllabusNodeChildren", fields: [parentId], references: [id])
  children           SyllabusNode[]      @relation("SyllabusNodeChildren")
  learningObjectives LearningObjective[]
  lessonPlans        LessonPlan[]
  classSessions      ClassSession[]
  knowledgeChecks    KnowledgeCheck[]

  @@index([organizationId])
  @@index([syllabusId])
  @@index([parentId])
  @@map("syllabus_nodes")
}

model LearningObjective {
  id             String   @id @default(uuid())
  organizationId String
  syllabusNodeId String
  sequence       Int
  description    String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  node         SyllabusNode @relation(fields: [syllabusNodeId], references: [id])

  @@index([organizationId])
  @@index([syllabusNodeId])
  @@map("learning_objectives")
}

// Tied to a TeachingAssignment (teacher+subject+section+term) and a
// SyllabusNode (what's being taught), not to a specific ClassSchedule
// occurrence or calendar date — a lesson plan is content a teacher
// prepares once and may reuse across sessions; binding it to one actual
// dated occurrence is 3d's job (class sessions / "My Classes Today"),
// not this slice's.
model LessonPlan {
  id                   String    @id @default(uuid())
  organizationId       String
  teachingAssignmentId String
  syllabusNodeId       String
  title                String
  objectives           String
  materials            String?
  plannedDate          DateTime?
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization       Organization       @relation(fields: [organizationId], references: [id])
  teachingAssignment TeachingAssignment @relation(fields: [teachingAssignmentId], references: [id])
  syllabusNode       SyllabusNode       @relation(fields: [syllabusNodeId], references: [id])
  classSessions      ClassSession[]

  @@index([organizationId])
  @@index([teachingAssignmentId])
  @@map("lesson_plans")
}

// ── Class Sessions (plan §6 "Teaching & Learning" — Phase 3 slice 3d) ──────
// Distinct from AttendanceSession (slice 3b): a ClassSession tracks what
// was actually *taught* (topic, progress, materials, completion), an
// AttendanceSession tracks who was *there* — the plan lists them as
// separate tables under separate domains, and the class-completion
// workflow (plan §8) treats "confirm attendance" and "select actual
// topic / record progress / mark completed" as separate steps. Both key
// off the same (classScheduleId, date) pair but are otherwise
// independent; the API surfaces both when listing a day's classes rather
// than merging them into one model.
//
// syllabus_progress is deliberately not a stored table — per-node
// progress (was this topic actually covered, and when) is fully derivable
// by querying ClassSession rows for COMPLETED sessions whose
// actualSyllabusNodeId matches a node, so a separate denormalized table
// would just be a second source of truth to keep in sync on every
// completion. Computed on read instead (plan §17 explicitly allows
// "materialized views/aggregation ... where appropriate" — an on-demand
// computed view is the simpler appropriate choice here, not a stored one).

enum ClassSessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

model ClassSession {
  id                   String             @id @default(uuid())
  organizationId       String
  classScheduleId      String
  // Denormalized off classSchedule, same reasoning as every prior
  // slice's session-shaped models (AttendanceSession, ClassSchedule
  // itself) — needed directly for the unique constraint and for
  // listing/filtering without a join.
  sectionId            String
  date                 DateTime
  lessonPlanId         String?
  // What was actually covered — may differ from the lesson plan's
  // intended node, which is exactly the "planned vs actual" distinction
  // plan §8 calls out.
  actualSyllabusNodeId String?
  progressNotes        String?
  status               ClassSessionStatus @default(SCHEDULED)
  completedAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization       Organization    @relation(fields: [organizationId], references: [id])
  classSchedule      ClassSchedule   @relation(fields: [classScheduleId], references: [id])
  section            Section         @relation(fields: [sectionId], references: [id])
  lessonPlan         LessonPlan?     @relation(fields: [lessonPlanId], references: [id])
  actualSyllabusNode SyllabusNode?   @relation(fields: [actualSyllabusNodeId], references: [id])
  materials          ClassMaterial[]

  @@unique([classScheduleId, date])
  @@index([organizationId])
  @@map("class_sessions")
}

// No file upload (same reasoning as every prior slice touching
// documents): the object-storage backend is still an open decision, and
// a class material here is a reference (title + optional link), not an
// uploaded file.
model ClassMaterial {
  id             String   @id @default(uuid())
  organizationId String
  classSessionId String
  title          String
  url            String?
  description    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  classSession ClassSession @relation(fields: [classSessionId], references: [id])

  @@index([organizationId])
  @@index([classSessionId])
  @@map("class_materials")
}

// ── Assignments & Knowledge Checks (plan §6 "Teaching & Learning" —
// Phase 3 slice 3e) ─────────────────────────────────────────────────────
// AI generation of either (plan §9's AI Knowledge Check/Assignment
// Generators) is explicitly Phase 5 scope, not this slice — this builds
// the real manual mechanics those generators will later populate.
//
// rubrics/rubric_items are deliberately not modeled — no structured-
// criteria grading requirement has been specified yet, so a plain
// score + feedback covers "grading and feedback" (plan §8) for now,
// same "defer until asked" reasoning applied to every prior slice's
// unspecified scope (e.g. slice 3c's syllabus_versions).
//
// knowledge_check "options" collapse into a JSON array on the question
// itself instead of a separate rubric_items-shaped child table — same
// collapsing reasoning as SyllabusNode: each option has no independent
// identity or behavior beyond "one of this question's choices."
//
// Neither Assignment nor KnowledgeCheck exists in a real student-facing
// portal yet (no student/parent login — a gap already noted in earlier
// phases), so submissions/attempts are recorded by admin on a student's
// behalf, the same pattern StudentAttendance already established.

enum SubmissionType {
  WRITTEN
  OBJECTIVE
  PROJECT
  PRACTICAL
  FILE
  IMAGE
  PDF
  LINK
  TEXT
}

model Assignment {
  id                   String         @id @default(uuid())
  organizationId       String
  teachingAssignmentId String
  title                String
  description          String?
  submissionType       SubmissionType
  dueDate              DateTime?
  allowResubmission    Boolean        @default(false)
  maxScore             Float?
  // Added for self-service assignments (LMS discovery slice 3) — a
  // student must never see a draft assignment a teacher is still
  // building, same publish-gating precedent as CourseModule/
  // CourseModuleItem. Defaults false so every admin-created assignment
  // from before this field existed reads as an unpublished draft, not
  // silently visible to students.
  isPublished          Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  organization       Organization           @relation(fields: [organizationId], references: [id])
  teachingAssignment TeachingAssignment     @relation(fields: [teachingAssignmentId], references: [id])
  submissions        AssignmentSubmission[]

  @@index([organizationId])
  @@map("assignments")
}

enum SubmissionStatus {
  SUBMITTED
  GRADED
}

model AssignmentSubmission {
  id             String           @id @default(uuid())
  organizationId String
  assignmentId   String
  studentId      String
  // Text or a link — no file upload, same reasoning as ClassMaterial;
  // FILE/IMAGE/PDF submission types store a reference here, not bytes.
  content        String?
  submittedAt    DateTime         @default(now())
  status         SubmissionStatus @default(SUBMITTED)
  score          Float?
  feedback       String?
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  assignment   Assignment   @relation(fields: [assignmentId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id])

  // One row per student per assignment — a resubmission (when the
  // assignment allows it) overwrites this row rather than stacking a
  // new one, so "latest submission" never needs a separate query.
  @@unique([assignmentId, studentId])
  @@index([organizationId])
  @@map("assignment_submissions")
}

enum KnowledgeCheckStatus {
  DRAFT
  PUBLISHED
}

model KnowledgeCheck {
  id                   String               @id @default(uuid())
  organizationId       String
  teachingAssignmentId String
  syllabusNodeId       String?
  title                String
  durationMinutes      Int?
  status               KnowledgeCheckStatus @default(DRAFT)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  organization       Organization             @relation(fields: [organizationId], references: [id])
  teachingAssignment TeachingAssignment       @relation(fields: [teachingAssignmentId], references: [id])
  syllabusNode       SyllabusNode?            @relation(fields: [syllabusNodeId], references: [id])
  questions          KnowledgeCheckQuestion[]
  attempts           KnowledgeCheckAttempt[]

  @@index([organizationId])
  @@map("knowledge_checks")
}

model KnowledgeCheckQuestion {
  id                 String   @id @default(uuid())
  organizationId     String
  knowledgeCheckId   String
  sequence           Int
  text               String
  // string[] — the answer choices, in display order.
  options            Json
  correctOptionIndex Int
  createdAt          DateTime @default(now())

  organization   Organization           @relation(fields: [organizationId], references: [id])
  knowledgeCheck KnowledgeCheck         @relation(fields: [knowledgeCheckId], references: [id])
  savedAnswers   KnowledgeCheckAnswer[]

  @@index([organizationId])
  @@index([knowledgeCheckId])
  @@map("knowledge_check_questions")
}

model KnowledgeCheckAttempt {
  id               String    @id @default(uuid())
  organizationId   String
  knowledgeCheckId String
  studentId        String
  // Set when a student starts the self-service quiz-taking flow (LMS
  // discovery slice 4); left null for an admin-recorded attempt (the
  // original CreateAttemptDto path, e.g. a paper-based in-class check
  // being logged after the fact), which never "starts" separately from
  // submitting.
  startedAt        DateTime?
  // number[] — the selected option index per question, in the same
  // order as KnowledgeCheck.questions. Null while a self-service attempt
  // is still in progress (see KnowledgeCheckAnswer for the autosaved,
  // per-question state); always set for an admin-recorded attempt and
  // for any attempt once submitted.
  answers          Json?
  // Percentage of questions answered correctly, computed server-side at
  // submission time — never trust a client-submitted score. Null until
  // scored.
  score            Float?
  // Null while in progress; set at submission time (self-service or
  // admin-recorded) — no longer defaults to now(), since a self-service
  // attempt's row is created at *start*, not submission.
  submittedAt      DateTime?

  organization   Organization           @relation(fields: [organizationId], references: [id])
  knowledgeCheck KnowledgeCheck         @relation(fields: [knowledgeCheckId], references: [id])
  student        Student                @relation(fields: [studentId], references: [id])
  savedAnswers   KnowledgeCheckAnswer[]

  // One attempt per student — these are short in-class checks, not a
  // retake-until-you-pass assessment; resubmission rules are an
  // Assignment concept, not a KnowledgeCheck one. Shared by both the
  // self-service and admin-recorded paths, so one can never double up
  // on the other.
  @@unique([knowledgeCheckId, studentId])
  @@index([organizationId])
  @@map("knowledge_check_attempts")
}

// Per-question autosave state for a self-service quiz attempt in
// progress — mirrors ExamTaking's Answer table exactly (same "save one
// question at a time, resume with the same shuffled order on refresh"
// shape), scoped to KnowledgeCheckAttempt instead of ExamAttempt since
// a quiz isn't tied to an exam schedule/window. Selected option index is
// always the question's real (unshuffled) index — the same
// seededShuffle-and-translate-back convention as exam-taking.
model KnowledgeCheckAnswer {
  id                      String   @id @default(uuid())
  organizationId          String
  knowledgeCheckAttemptId String
  questionId              String
  selectedOptionIndex     Int
  updatedAt               DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id])
  attempt      KnowledgeCheckAttempt  @relation(fields: [knowledgeCheckAttemptId], references: [id])
  question     KnowledgeCheckQuestion @relation(fields: [questionId], references: [id])

  @@unique([knowledgeCheckAttemptId, questionId])
  @@index([organizationId])
  @@map("knowledge_check_answers")
}

// --- Phase 4 slice 4a: exam structure & question banks -------------------
// Foundation for the rest of Phase 4 (exams/scheduling in 4b, attempts/
// evaluation in 4c, grades/report cards in 4d) — see docs/PHASE_4_NOTES.md.

model ExamType {
  id             String   @id @default(uuid())
  organizationId String
  // e.g. "Terminal Exam", "Unit Test", "Final Exam" — an institution-
  // defined category an Exam (4b) will reference, same role StaffType
  // plays for Employee.
  name           String
  code           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  exams        Exam[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("exam_types")
}

model GradingScheme {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String
  description    String?
  // Array of { minPercentage, maxPercentage, grade, gpa?, remarks? },
  // ordered highest-to-lowest — a separate grade_bands table isn't
  // listed in the plan's flat table list for this domain, and a band
  // has no independent identity/behavior beyond "one row of this
  // scheme's scale," the same collapsing reasoning already applied to
  // KnowledgeCheckQuestion.options and Assignment's rubric fields.
  bands          Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  exams        Exam[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("grading_schemes")
}

model QuestionBank {
  id                  String   @id @default(uuid())
  organizationId      String
  // Not term-scoped like Syllabus — a bank of questions for a subject
  // is reusable across exams and terms, unlike a syllabus which tracks
  // one term's actual coverage.
  curriculumSubjectId String
  name                String
  description         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization      Organization      @relation(fields: [organizationId], references: [id])
  curriculumSubject CurriculumSubject @relation(fields: [curriculumSubjectId], references: [id])
  questions         Question[]
  examSubjects      ExamSubject[]

  @@index([organizationId])
  @@index([curriculumSubjectId])
  @@map("question_banks")
}

enum QuestionType {
  // Single correct choice among `options`, auto-scored later (4c) —
  // never trust a client-submitted score, same rule as KnowledgeCheck.
  OBJECTIVE
  // Free-text, manually marked — no options/correctOptionIndex.
  SUBJECTIVE
}

model Question {
  id                 String       @id @default(uuid())
  organizationId     String
  questionBankId     String
  sequence           Int
  text               String
  questionType       QuestionType
  // Points this question is worth within any exam that draws on it.
  marks              Int
  // string[], OBJECTIVE only — the answer choices, in display order.
  options            Json?
  // OBJECTIVE only.
  correctOptionIndex Int?
  // SUBJECTIVE only, optional — a reference answer/marking note for
  // the human grader; never used for auto-scoring.
  modelAnswer        String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  questionBank QuestionBank @relation(fields: [questionBankId], references: [id])
  answers      Answer[]

  @@index([organizationId])
  @@index([questionBankId])
  @@map("questions")
}

model Exam {
  id              String   @id @default(uuid())
  organizationId  String
  examTypeId      String
  termId          String
  name            String
  // Optional — an exam can exist before its grading scale is decided;
  // 4d's grade computation requires it, this slice's scheduling doesn't.
  gradingSchemeId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id])
  examType      ExamType       @relation(fields: [examTypeId], references: [id])
  term          Term           @relation(fields: [termId], references: [id])
  gradingScheme GradingScheme? @relation(fields: [gradingSchemeId], references: [id])
  examSubjects  ExamSubject[]
  reportCards   ReportCard[]

  @@index([organizationId])
  @@index([termId])
  @@map("exams")
}

model ExamSubject {
  id                  String   @id @default(uuid())
  organizationId      String
  examId              String
  curriculumSubjectId String
  fullMarks           Int
  passMarks           Int
  // Optional — a traditional paper exam subject (4a-4d's whole existing
  // scope) has none. Only set when this subject is delivered online; a
  // student can only start an exam that has one. Must share this
  // subject's curriculumSubjectId (validated in the service).
  questionBankId      String?
  createdAt           DateTime @default(now())

  organization      Organization      @relation(fields: [organizationId], references: [id])
  exam              Exam              @relation(fields: [examId], references: [id])
  curriculumSubject CurriculumSubject @relation(fields: [curriculumSubjectId], references: [id])
  questionBank      QuestionBank?     @relation(fields: [questionBankId], references: [id])
  // At most one schedule per exam subject — a subject is examined once
  // within a given exam sitting; a subject with a written and a
  // practical component is two ExamSubject rows (two CurriculumSubject-
  // level marks entries), not one ExamSubject with two schedules.
  examSchedule      ExamSchedule?
  examAttempts      ExamAttempt[]

  @@unique([examId, curriculumSubjectId])
  @@index([organizationId])
  @@map("exam_subjects")
}

model ExamSchedule {
  id             String   @id @default(uuid())
  organizationId String
  examSubjectId  String   @unique
  date           DateTime
  // "HH:mm" 24-hour strings — same reasoning as Period's startTime/
  // endTime, a real Postgres `time` column doesn't map to a native
  // Prisma scalar without extra tooling.
  startTime      String
  endTime        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  examSubject  ExamSubject  @relation(fields: [examSubjectId], references: [id])
  examRooms    ExamRoom[]

  @@index([organizationId])
  @@map("exam_schedules")
}

model ExamRoom {
  id             String   @id @default(uuid())
  organizationId String
  examScheduleId String
  roomId         String
  // A large sitting can split across multiple rooms — capacity tracks
  // how many seats this room contributes, not a hard cap enforced here.
  capacity       Int?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  examSchedule ExamSchedule @relation(fields: [examScheduleId], references: [id])
  room         Room         @relation(fields: [roomId], references: [id])

  @@unique([examScheduleId, roomId])
  @@index([organizationId])
  @@index([roomId])
  @@map("exam_rooms")
}

model ExamAttempt {
  id             String           @id @default(uuid())
  organizationId String
  examSubjectId  String
  studentId      String
  // Reuses AttendanceStatus (present/absent/late/excused) rather than a
  // new narrower enum — the same four values are meaningful for "did
  // this student sit this exam" as for daily class attendance, and
  // introducing a parallel enum for identical semantics would be a new
  // abstraction with no behavioral difference.
  status         AttendanceStatus @default(PRESENT)
  // Online exam-taking lifecycle, layered onto this same row rather
  // than a parallel table — this row already models "this student is
  // taking this exam subject," admin-created as the eligibility gate a
  // student must have before they can start. Both null until the
  // student actually opens/submits an online exam; paper exams (no
  // linked QuestionBank on ExamSubject) never set either.
  startedAt      DateTime?
  submittedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  examSubject  ExamSubject  @relation(fields: [examSubjectId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id])
  marks        Marks?
  grade        Grade?
  answers      Answer[]

  // One attempt per student per exam subject — admin-recorded on the
  // student's behalf, same pattern as AssignmentSubmission/
  // KnowledgeCheckAttempt (no student portal exists yet). Deliberately
  // not roster-based like AttendanceSession: an exam subject has no
  // direct sectionId to compute a roster from (it's reached via
  // CurriculumSubject, which can span multiple sections/programs), so
  // admin picks the specific student explicitly, the same choice
  // already made for assignments and knowledge checks.
  @@unique([examSubjectId, studentId])
  @@index([organizationId])
  // Analytics/dashboard reads filter by studentId alone — Phase 8
  // performance-optimization slice.
  @@index([studentId])
  @@map("exam_attempts")
}

model Marks {
  id             String   @id @default(uuid())
  organizationId String
  examAttemptId  String   @unique
  obtainedMarks  Int
  remarks        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  examAttempt  ExamAttempt  @relation(fields: [examAttemptId], references: [id])

  @@index([organizationId])
  @@map("marks")
}

model Grade {
  id             String   @id @default(uuid())
  organizationId String
  examAttemptId  String   @unique
  // Snapshotted at computation time, not recomputed on read — a grade
  // is meant to be stable even if the grading scheme's bands change
  // later (e.g. an institution revises cutoffs after report cards have
  // already been issued).
  percentage     Float
  grade          String
  gpa            Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  examAttempt  ExamAttempt  @relation(fields: [examAttemptId], references: [id])

  @@index([organizationId])
  @@map("grades")
}

model ReportCard {
  id                 String   @id @default(uuid())
  organizationId     String
  examId             String
  studentId          String
  totalObtainedMarks Int
  totalFullMarks     Int
  percentage         Float
  overallGrade       String
  overallGpa         Float?
  // The per-subject breakdown isn't duplicated here — it's already
  // queryable via Grade rows joined through ExamAttempt/ExamSubject for
  // this exam+student, and storing a second copy would just be a sync
  // hazard. This row snapshots only the aggregate figures, the part
  // that's actually a computation over multiple rows at a point in time.
  generatedAt        DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  exam         Exam         @relation(fields: [examId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id])

  @@unique([examId, studentId])
  @@index([organizationId])
  @@map("report_cards")
}

model Answer {
  id                  String   @id @default(uuid())
  organizationId      String
  examAttemptId       String
  questionId          String
  // OBJECTIVE only.
  selectedOptionIndex Int?
  // SUBJECTIVE only.
  textAnswer          String?
  // Auto-computed for OBJECTIVE on submit (never trust a client-
  // submitted score, same rule KnowledgeCheckAttempt and
  // ExamGradingService already follow) — null until then, and stays
  // null for SUBJECTIVE pending human grading via 4c/4d's existing
  // admin actions, which this table feeds but never bypasses.
  score               Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  examAttempt  ExamAttempt  @relation(fields: [examAttemptId], references: [id])
  question     Question     @relation(fields: [questionId], references: [id])

  // One answer per question per attempt — autosave and submit both
  // upsert this row rather than stacking a new one each save.
  @@unique([examAttemptId, questionId])
  @@index([organizationId])
  @@map("answers")
}

// ── Finance (plan §6/§20 — Phase 7 slice 7a-1) ──────────────────────────
// Fee structures, invoicing, and manual payment recording (cash/bank
// transfer/cheque). Online payment (eSewa) is slice 7a-2, layered on top
// of Invoice/Payment once they exist — a gateway integration needs real
// invoices to attach to. Decimal is used for every money field — no
// monetary type existed anywhere in this schema before this slice (only
// Float, for academic scores, which is not safe for money). NPR is the
// only currency the plan specifies; no multi-currency scope.

model FeeCategory {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id])
  feeStructureItems FeeStructureItem[]
  invoiceItems      InvoiceItem[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("fee_categories")
}

model FeeStructure {
  id             String   @id @default(uuid())
  organizationId String
  programId      String
  termId         String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id])
  program      Program                @relation(fields: [programId], references: [id])
  term         Term                   @relation(fields: [termId], references: [id])
  items        FeeStructureItem[]
  assignments  StudentFeeAssignment[]

  @@unique([programId, termId, name])
  @@index([organizationId])
  @@map("fee_structures")
}

model FeeStructureItem {
  id             String  @id @default(uuid())
  organizationId String
  feeStructureId String
  feeCategoryId  String
  amount         Decimal @db.Decimal(12, 2)

  organization Organization @relation(fields: [organizationId], references: [id])
  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id])
  feeCategory  FeeCategory  @relation(fields: [feeCategoryId], references: [id])

  @@unique([feeStructureId, feeCategoryId])
  @@index([organizationId])
  @@map("fee_structure_items")
}

// Assignment *is* invoicing — creating this row creates the Invoice in
// the same transaction, no separate "generate" step, matching how
// enrollment itself is a single action rather than drafted-then-confirmed.
model StudentFeeAssignment {
  id                  String   @id @default(uuid())
  organizationId      String
  studentEnrollmentId String
  feeStructureId      String
  invoiceId           String   @unique
  assignedAt          DateTime @default(now())
  assignedBy          String?

  organization      Organization      @relation(fields: [organizationId], references: [id])
  studentEnrollment StudentEnrollment @relation(fields: [studentEnrollmentId], references: [id])
  feeStructure      FeeStructure      @relation(fields: [feeStructureId], references: [id])
  invoice           Invoice           @relation(fields: [invoiceId], references: [id])
  assigner          User?             @relation(fields: [assignedBy], references: [id])

  @@unique([studentEnrollmentId, feeStructureId])
  @@index([organizationId])
  @@map("student_fee_assignments")
}

enum InvoiceStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

// totalAmount is the gross snapshot at creation time (sum of items,
// before any discount) — immutable, same reasoning as Grade staying
// stable after its GradingScheme might later change. The amount
// actually owed (totalAmount minus discounts minus payments) and
// whether it's overdue (dueDate vs now) are both computed on read, not
// stored — avoids a background job just to flip a status over time.
model Invoice {
  id                  String        @id @default(uuid())
  organizationId      String
  studentId           String
  studentEnrollmentId String
  totalAmount         Decimal       @db.Decimal(12, 2)
  dueDate             DateTime
  status              InvoiceStatus @default(PENDING)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  organization      Organization           @relation(fields: [organizationId], references: [id])
  student           Student                @relation(fields: [studentId], references: [id])
  studentEnrollment StudentEnrollment      @relation(fields: [studentEnrollmentId], references: [id])
  items             InvoiceItem[]
  payments          Payment[]
  discounts         Discount[]
  feeAssignment     StudentFeeAssignment?
  transactions      FinancialTransaction[]
  esewaTransactions EsewaTransaction[]

  @@index([organizationId])
  // Per-student invoice lookups filter on this directly — Phase 8
  // performance-optimization slice.
  @@index([studentId])
  @@map("invoices")
}

model InvoiceItem {
  id             String  @id @default(uuid())
  organizationId String
  invoiceId      String
  feeCategoryId  String
  description    String?
  amount         Decimal @db.Decimal(12, 2)

  organization Organization @relation(fields: [organizationId], references: [id])
  invoice      Invoice      @relation(fields: [invoiceId], references: [id])
  feeCategory  FeeCategory  @relation(fields: [feeCategoryId], references: [id])

  @@index([organizationId])
  @@map("invoice_items")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  // Added in slice 7a-2 (not used yet, defined now so the enum doesn't
  // need a later migration touching every existing row).
  ESEWA
}

// Partial payments allowed — an invoice can be paid across several rows,
// matching real institutional practice.
model Payment {
  id             String        @id @default(uuid())
  organizationId String
  invoiceId      String
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod
  // Cheque/bank-transfer reference number this slice; will carry the
  // gateway transaction id for ESEWA payments once 7a-2 adds them.
  reference      String?
  recordedBy     String?
  paidAt         DateTime      @default(now())
  createdAt      DateTime      @default(now())

  organization Organization           @relation(fields: [organizationId], references: [id])
  invoice      Invoice                @relation(fields: [invoiceId], references: [id])
  recorder     User?                  @relation(fields: [recordedBy], references: [id])
  refunds      Refund[]
  transactions FinancialTransaction[]

  @@index([organizationId])
  @@index([invoiceId])
  @@map("payments")
}

// A reusable, ongoing catalog entry — StudentScholarship assigns one to
// a student, and it's auto-applied (as a Discount, see below) the next
// time an invoice is generated for them. Exactly one of
// percentage/amount is expected to be set (enforced at the service
// layer, same XOR pattern as FaceEnrollment's studentId/staffId).
model Scholarship {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  percentage     Float?
  amount         Decimal? @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id])
  assignments  StudentScholarship[]
  discounts    Discount[]

  @@index([organizationId])
  @@map("scholarships")
}

model StudentScholarship {
  id             String   @id @default(uuid())
  organizationId String
  studentId      String
  scholarshipId  String
  assignedAt     DateTime @default(now())
  active         Boolean  @default(true)

  organization Organization @relation(fields: [organizationId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id])
  scholarship  Scholarship  @relation(fields: [scholarshipId], references: [id])

  @@unique([studentId, scholarshipId])
  @@index([organizationId])
  @@map("student_scholarships")
}

// Reduces one specific invoice's payable total. scholarshipId is set
// only when this row was auto-created from a StudentScholarship at
// invoice-generation time (appliedBy null in that case); an ad-hoc
// admin-applied discount has scholarshipId null and a real appliedBy.
// Both cases share one mechanism rather than inventing a parallel
// "invoice.scholarshipDiscountAmount" field.
model Discount {
  id             String   @id @default(uuid())
  organizationId String
  invoiceId      String
  scholarshipId  String?
  amount         Decimal  @db.Decimal(12, 2)
  reason         String
  appliedBy      String?
  createdAt      DateTime @default(now())

  organization Organization           @relation(fields: [organizationId], references: [id])
  invoice      Invoice                @relation(fields: [invoiceId], references: [id])
  scholarship  Scholarship?           @relation(fields: [scholarshipId], references: [id])
  applier      User?                  @relation(fields: [appliedBy], references: [id])
  transactions FinancialTransaction[]

  @@index([organizationId])
  @@map("discounts")
}

// A ledger fact only — this slice (and 7a-2) never attempts to move
// money back out through a gateway programmatically; a real refund-API
// integration is its own, separately-scoped follow-up if ever needed.
model Refund {
  id             String   @id @default(uuid())
  organizationId String
  paymentId      String
  amount         Decimal  @db.Decimal(12, 2)
  reason         String
  processedBy    String?
  createdAt      DateTime @default(now())

  organization Organization           @relation(fields: [organizationId], references: [id])
  payment      Payment                @relation(fields: [paymentId], references: [id])
  processor    User?                  @relation(fields: [processedBy], references: [id])
  transactions FinancialTransaction[]

  @@index([organizationId])
  @@map("refunds")
}

enum FinancialTransactionType {
  INVOICE_CREATED
  PAYMENT_RECORDED
  DISCOUNT_APPLIED
  SCHOLARSHIP_APPLIED
  REFUND_ISSUED
}

// Append-only audit trail — unlike syllabus_progress (computed, not
// stored, cheap to recompute, no audit requirement), money needs an
// immutable history. Invoice/Payment stay the live queryable state;
// this is the ledger, never itself a source of truth for current status.
model FinancialTransaction {
  id             String                   @id @default(uuid())
  organizationId String
  type           FinancialTransactionType
  amount         Decimal                  @db.Decimal(12, 2)
  invoiceId      String?
  paymentId      String?
  discountId     String?
  refundId       String?
  createdAt      DateTime                 @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id])
  payment      Payment?     @relation(fields: [paymentId], references: [id])
  discount     Discount?    @relation(fields: [discountId], references: [id])
  refund       Refund?      @relation(fields: [refundId], references: [id])

  @@index([organizationId])
  @@map("financial_transactions")
}

enum EsewaTransactionStatus {
  INITIATED
  COMPLETE
  FAILED
  CANCELED
}

// One row per "pay with eSewa" attempt — deliberately separate from
// Payment, same reasoning as ClassSession staying separate from
// AttendanceSession: an initiated gateway attempt and money that
// actually arrived are different owners with different lifecycles.
// Only a COMPLETE row here ever produces a real Payment. transactionUuid
// is the durable, unique anchor that makes confirmEsewaPayment
// idempotent — a reloaded callback page or a double-submitted "pay"
// click never double-credits.
model EsewaTransaction {
  id              String                 @id @default(uuid())
  organizationId  String
  invoiceId       String
  transactionUuid String                 @unique
  amount          Decimal                @db.Decimal(12, 2)
  status          EsewaTransactionStatus @default(INITIATED)
  // eSewa's own transaction_code, set once status is COMPLETE.
  esewaRefId      String?
  // Null for portal self-service (a student paying their own
  // invoice) — no staff member initiated it in that case.
  initiatedBy     String?
  createdAt       DateTime               @default(now())
  completedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  invoice      Invoice      @relation(fields: [invoiceId], references: [id])
  initiator    User?        @relation(fields: [initiatedBy], references: [id])

  @@index([organizationId])
  @@index([invoiceId])
  @@map("esewa_transactions")
}

// ── HR & Payroll, part 1: Leave Management (Phase 7 slice 7b-1) ────────
// Everything else in the Staff & HR domain (Employee, StaffType,
// Designation, EmploymentHistory, Qualification, TeacherProfile) was
// already built in Phase 2 slice 2b — this section is the genuinely new
// scope. Payroll (salary_structures/payroll/payroll_items) is slice
// 7b-2, layered on top of this below.

model LeaveType {
  id                 String   @id @default(uuid())
  organizationId     String
  name               String
  code               String
  defaultDaysPerYear Int
  isPaid             Boolean  @default(true)
  carryForward       Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id])
  balances     StaffLeaveBalance[]
  requests     LeaveRequest[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("leave_types")
}

// Stores only the allocation ("12 sick days for 2026") — a discrete
// admin action, not something to derive. usedDays/remainingDays are
// computed on read by summing this employee+type+year's APPROVED
// LeaveRequest rows, same reasoning as syllabus_progress elsewhere in
// this project: cheaply derivable, no audit-trail need of its own.
model StaffLeaveBalance {
  id             String @id @default(uuid())
  organizationId String
  employeeId     String
  leaveTypeId    String
  year           Int
  allocatedDays  Int

  organization Organization @relation(fields: [organizationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])
  leaveType    LeaveType    @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
  @@index([organizationId])
  @@map("staff_leave_balances")
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id             String             @id @default(uuid())
  organizationId String
  employeeId     String
  leaveTypeId    String
  startDate      DateTime
  endDate        DateTime
  // Whole days only, computed server-side from the date range at
  // creation — no half-day support this slice.
  days           Int
  reason         String?
  status         LeaveRequestStatus @default(PENDING)
  reviewedBy     String?
  reviewedAt     DateTime?
  reviewComment  String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])
  leaveType    LeaveType    @relation(fields: [leaveTypeId], references: [id])
  reviewer     User?        @relation(fields: [reviewedBy], references: [id])

  @@index([organizationId])
  @@index([employeeId])
  @@map("leave_requests")
}

// ── HR & Payroll, part 2: Payroll (Phase 7 slice 7b-2) ──────────────────
// salary_structures/payroll/payroll_items — the plan gives no field-level
// spec (docx §6 lists only these three bare table names). Deductions
// (income tax, provident fund, ...) are deliberately generic
// admin-configurable line items, not hardcoded Nepali tax-slab/SSF
// calculation logic — that's government fiscal-year policy that changes
// yearly, not a fixed protocol like eSewa's (7a-2); same reasoning this
// project already applies to GradingScheme's admin-configurable bands.

enum PayrollItemType {
  EARNING
  DEDUCTION
}

// Reusable org-level compensation template — the plan's "salary
// structure". Employee.salaryStructureId points at the employee's
// *current* one; Payroll snapshots items at generation time, so this can
// be edited freely without touching already-generated payroll.
model SalaryStructure {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  basicSalary    Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id])
  items        SalaryStructureItem[]
  employees    Employee[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("salary_structures")
}

// Exactly one of amount/percentOfBasic is set — same XOR precedent as
// Scholarship's percentage/amount-exclusive rule (7a-1).
model SalaryStructureItem {
  id                String          @id @default(uuid())
  organizationId    String
  salaryStructureId String
  type              PayrollItemType
  name              String
  amount            Decimal?        @db.Decimal(12, 2)
  percentOfBasic    Decimal?        @db.Decimal(5, 2)

  organization    Organization    @relation(fields: [organizationId], references: [id])
  salaryStructure SalaryStructure @relation(fields: [salaryStructureId], references: [id])

  @@index([organizationId])
  @@index([salaryStructureId])
  @@map("salary_structure_items")
}

enum PayrollStatus {
  DRAFT
  FINALIZED
  PAID
  CANCELLED
}

// One row per employee per period. grossPay/totalDeductions/netPay are
// computed and frozen at finalize time — an immutable snapshot, same
// reasoning as Invoice.totalAmount never being live-recomputed.
model Payroll {
  id              String         @id @default(uuid())
  organizationId  String
  employeeId      String
  periodMonth     Int
  periodYear      Int
  status          PayrollStatus  @default(DRAFT)
  grossPay        Decimal?       @db.Decimal(12, 2)
  totalDeductions Decimal?       @db.Decimal(12, 2)
  netPay          Decimal?       @db.Decimal(12, 2)
  paymentMethod   PaymentMethod?
  paidAt          DateTime?
  finalizedAt     DateTime?
  finalizedBy     String?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  employee     Employee      @relation(fields: [employeeId], references: [id])
  finalizer    User?         @relation(fields: [finalizedBy], references: [id])
  items        PayrollItem[]

  @@unique([employeeId, periodMonth, periodYear])
  @@index([organizationId])
  @@map("payroll")
}

// Snapshotted from SalaryStructureItem at generation time (mirrors
// InvoiceItem mirroring FeeStructureItem), plus one auto-generated
// unpaid-leave deduction item when applicable. Editable only while the
// parent Payroll is DRAFT.
model PayrollItem {
  id             String          @id @default(uuid())
  organizationId String
  payrollId      String
  type           PayrollItemType
  name           String
  amount         Decimal         @db.Decimal(12, 2)

  organization Organization @relation(fields: [organizationId], references: [id])
  payroll      Payroll      @relation(fields: [payrollId], references: [id])

  @@index([organizationId])
  @@index([payrollId])
  @@map("payroll_items")
}

// ── Transport, part 1: core roster (Phase 7 slice 7d-1) ─────────────────
// vehicles/drivers/routes/stops/student_transport_assignments — the plan
// gives no field-level spec (docx §6 lists only these bare table names,
// plus vehicle_tracking_events which is 7d-2, layered on top of this
// later once real-time location/navigation is scoped).

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

model Vehicle {
  id                 String        @id @default(uuid())
  organizationId     String
  registrationNumber String
  type               String
  capacity           Int
  status             VehicleStatus @default(ACTIVE)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  organization   Organization           @relation(fields: [organizationId], references: [id])
  routes         Route[]
  trackingEvents VehicleTrackingEvent[]

  @@unique([organizationId, registrationNumber])
  @@index([organizationId])
  @@map("vehicles")
}

// Extends Employee exactly like TeacherProfile does — a driver is a kind
// of staff member, not a parallel identity.
model Driver {
  id             String   @id @default(uuid())
  organizationId String
  employeeId     String   @unique
  licenseNumber  String
  licenseExpiry  DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])

  @@index([organizationId])
  @@map("drivers")
}

// vehicleId/driverId are nullable — a route can exist in draft form
// before a vehicle/driver is assigned to it, same "assignment is a
// separate, optional step" reasoning used elsewhere in this project.
model Route {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String
  vehicleId      String?
  driverId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization                 @relation(fields: [organizationId], references: [id])
  vehicle        Vehicle?                     @relation(fields: [vehicleId], references: [id])
  driver         Employee?                    @relation("routesAsDriver", fields: [driverId], references: [id])
  stops          Stop[]
  assignments    StudentTransportAssignment[]
  trackingEvents VehicleTrackingEvent[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("routes")
}

// Belongs to exactly one route (not a many-to-many stops↔routes join) —
// simplest defensible model; a stop genuinely shared by two routes in
// reality is just two rows, matching this project's "don't build
// unrequested flexibility" precedent.
model Stop {
  id                   String   @id @default(uuid())
  organizationId       String
  routeId              String
  name                 String
  sequence             Int
  arrivalOffsetMinutes Int?
  // Nullable — a stop can be recorded before its coordinates are known;
  // added in slice 7d-2 so the driver map can plot stops and route a
  // line to the next one. Same Decimal(9,6) GPS precision as
  // VehicleTrackingEvent.
  latitude             Decimal? @db.Decimal(9, 6)
  longitude            Decimal? @db.Decimal(9, 6)

  organization Organization                 @relation(fields: [organizationId], references: [id])
  route        Route                        @relation(fields: [routeId], references: [id])
  assignments  StudentTransportAssignment[]

  @@unique([routeId, sequence])
  @@index([organizationId])
  @@map("stops")
}

// Anchors to studentEnrollmentId (not studentId directly), same
// precedent as StudentFeeAssignment since the enrollment already
// carries both. @@unique on studentEnrollmentId — one active assignment
// per enrollment at a time, matching Employee.salaryStructureId's
// "current pointer, repoint rather than stack history" precedent.
model StudentTransportAssignment {
  id                  String   @id @default(uuid())
  organizationId      String
  studentEnrollmentId String   @unique
  routeId             String
  stopId              String
  assignedAt          DateTime @default(now())

  organization      Organization      @relation(fields: [organizationId], references: [id])
  studentEnrollment StudentEnrollment @relation(fields: [studentEnrollmentId], references: [id])
  route             Route             @relation(fields: [routeId], references: [id])
  stop              Stop              @relation(fields: [stopId], references: [id])

  @@index([organizationId])
  @@index([routeId])
  @@map("student_transport_assignments")
}

// ── Transport, part 2: driver location + navigation (Phase 7 slice 7d-2) ─
// vehicle_tracking_events — the plan's last remaining Transport ERD table.
// routeId is nullable — a ping might arrive between route assignments.
model VehicleTrackingEvent {
  id             String   @id @default(uuid())
  organizationId String
  vehicleId      String
  routeId        String?
  latitude       Decimal  @db.Decimal(9, 6)
  longitude      Decimal  @db.Decimal(9, 6)
  recordedAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id])
  route        Route?       @relation(fields: [routeId], references: [id])

  @@index([organizationId])
  @@index([vehicleId, recordedAt])
  @@map("vehicle_tracking_events")
}

// ── LMS: course modules & content (LMS discovery slice 2) ──────────
// "Course" isn't a new concept — TeachingAssignment already is one
// (subject+section+term+teacher, the exact granularity Assignment and
// KnowledgeCheck already anchor to). Modules are scoped to it rather
// than to Syllabus, which is curriculum-wide and can span multiple
// teachers/sections/terms — module organization is this specific
// teacher's own call for this specific class.
model CourseModule {
  id                   String   @id @default(uuid())
  organizationId       String
  teachingAssignmentId String
  title                String
  description          String?
  sequence             Int
  isPublished          Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization       Organization       @relation(fields: [organizationId], references: [id])
  teachingAssignment TeachingAssignment @relation(fields: [teachingAssignmentId], references: [id])
  items              CourseModuleItem[]

  @@unique([teachingAssignmentId, sequence])
  @@index([organizationId])
  @@map("course_modules")
}

enum CourseModuleItemType {
  PAGE
  LINK
  VIDEO
  DOCUMENT
}

model CourseModuleItem {
  id             String               @id @default(uuid())
  organizationId String
  moduleId       String
  sequence       Int
  title          String
  type           CourseModuleItemType
  // PAGE: the rich-text content itself. LINK/VIDEO/DOCUMENT: an
  // external URL — no object storage exists in this project yet (see
  // docs/LMS_NOTES.md), so "uploading" a document/video means linking
  // one, same precedent as ClassMaterial.
  content        String
  isPublished    Boolean              @default(false)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization                 @relation(fields: [organizationId], references: [id])
  module       CourseModule                 @relation(fields: [moduleId], references: [id])
  completions  CourseModuleItemCompletion[]

  @@unique([moduleId, sequence])
  @@index([organizationId])
  @@map("course_module_items")
}

// A student marking an item as done — deliberately just a timestamped
// join row, not a richer "progress" table; module-level completion
// percentage is computed on read (same "computed, not stored"
// precedent as syllabus_progress) from how many of a module's
// published items have a completion row for that student.
model CourseModuleItemCompletion {
  id             String   @id @default(uuid())
  organizationId String
  moduleItemId   String
  studentId      String
  completedAt    DateTime @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id])
  moduleItem   CourseModuleItem @relation(fields: [moduleItemId], references: [id])
  student      Student          @relation(fields: [studentId], references: [id])

  @@unique([moduleItemId, studentId])
  @@index([organizationId])
  @@map("course_module_item_completions")
}

// Course-level announcements (LMS discovery slice 5) — a one-way,
// teacher-owned broadcast to everyone enrolled in one course, same
// draft/publish gate as every other piece of teacher content
// (CourseModule/Assignment/KnowledgeCheck): a draft is invisible to
// students until the owning teacher explicitly publishes it. No
// per-student read-tracking or replies — that's a discussions concept
// (a later, separate slice), not asked for here.
model Announcement {
  id                   String   @id @default(uuid())
  organizationId       String
  teachingAssignmentId String
  title                String
  body                 String
  isPublished          Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization       Organization       @relation(fields: [organizationId], references: [id])
  teachingAssignment TeachingAssignment @relation(fields: [teachingAssignmentId], references: [id])

  @@index([organizationId])
  @@map("announcements")
}

// Course-level discussions (LMS discovery slice 6) — a teacher-created
// topic (same draft/publish gate as Announcement) that both the owning
// teacher and any student enrolled in the course can reply to. Flat
// replies only, deliberately — nested/threaded replies weren't asked
// for, and this project's own "don't build unrequested flexibility"
// precedent applies here exactly as it did to Stop-per-Route in
// Transport.
model DiscussionTopic {
  id                   String   @id @default(uuid())
  organizationId       String
  teachingAssignmentId String
  title                String
  body                 String
  isPublished          Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization       Organization       @relation(fields: [organizationId], references: [id])
  teachingAssignment TeachingAssignment @relation(fields: [teachingAssignmentId], references: [id])
  posts              DiscussionPost[]

  @@index([organizationId])
  @@map("discussion_topics")
}

model DiscussionPost {
  id                String   @id @default(uuid())
  organizationId    String
  discussionTopicId String
  // Exactly one of these two is set — same "typed nullable FKs instead
  // of an untyped personId+personType pair" pattern as
  // FaceEnrollment.studentId/staffId; the XOR is enforced at the
  // service layer, not a DB constraint.
  authorStudentId   String?
  authorEmployeeId  String?
  body              String
  createdAt         DateTime @default(now())

  organization    Organization    @relation(fields: [organizationId], references: [id])
  discussionTopic DiscussionTopic @relation(fields: [discussionTopicId], references: [id])
  authorStudent   Student?        @relation(fields: [authorStudentId], references: [id])
  authorEmployee  Employee?       @relation(fields: [authorEmployeeId], references: [id])

  @@index([organizationId])
  @@index([discussionTopicId])
  @@map("discussion_posts")
}

// Persistent, in-app notifications (LMS discovery slice 9) — closes the
// gap flagged in discovery: "only ephemeral client-side toasts exist,"
// gone the moment the page is closed or the action happened while the
// recipient wasn't looking. Keyed by User.id, not Student/Employee —
// a notification is "for whoever is logged into this account,"
// independent of role, matching how the JWT's own identity resolves.
// A student/employee with no portal login simply can't receive one,
// same as every other self-service feature in this project. No
// real-time delivery (no websocket/push infra exists anywhere in this
// project, same standing precedent as Transport's tracking polling) —
// the client polls this table.
model Notification {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  // Free text, not an enum — same "plan forbids hard-coded
  // institution-specific vocabularies" reasoning that already applies
  // to Vehicle.type/Student.gender elsewhere; new notification-worthy
  // events shouldn't require a migration to add a variant.
  type           String
  title          String
  body           String?
  // A relative path the client navigates to on click (e.g.
  // "/portal/assignments") — never an absolute URL, this is an
  // in-app destination only.
  link           String?
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@map("notifications")
}

// ── Hostel (Phase 7 slice 7e) ──────────────────────────────────────────
// hostel → building → room → bed → allocation, same nesting depth as
// Transport's route → stop, one level deeper to match the plan's own
// ERD (docx §14: "hostels, buildings, rooms, beds, allocations,
// hostel_attendance, hostel_payments, hostel_visitors,
// hostel_complaints, hostel_maintenance"). Deliberately no
// hostel_payments table — hostel fees reuse Finance's existing
// FeeStructure/Invoice machinery exactly as-is (create a FeeStructure
// for the relevant program+term, assign it to the allocated student's
// enrollment via the already-built assign-fee-structure flow), the
// same "same fee-routing story as 7c" reuse already noted for Library
// fines — a second, parallel payment/invoice system would duplicate
// what Invoice/Payment/Refund/Discount already do generically.

model Hostel {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String
  address        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id])
  buildings    HostelBuilding[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("hostels")
}

model HostelBuilding {
  id             String   @id @default(uuid())
  organizationId String
  hostelId       String
  name           String
  code           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  hostel       Hostel       @relation(fields: [hostelId], references: [id])
  rooms        HostelRoom[]

  @@unique([hostelId, code])
  @@index([organizationId])
  @@map("hostel_buildings")
}

model HostelRoom {
  id             String   @id @default(uuid())
  organizationId String
  buildingId     String
  roomNumber     String
  // Free text, not an enum — institutions name their own room
  // categories ("Standard", "AC Double", ...), same reasoning as
  // Vehicle.type.
  roomType       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization        Organization               @relation(fields: [organizationId], references: [id])
  building            HostelBuilding             @relation(fields: [buildingId], references: [id])
  beds                HostelBed[]
  maintenanceRequests HostelMaintenanceRequest[]

  @@unique([buildingId, roomNumber])
  @@index([organizationId])
  @@map("hostel_rooms")
}

// AVAILABLE/MAINTENANCE only — whether a bed is currently *occupied* is
// computed on read from whether a HostelAllocation references it (same
// "computed, not stored" precedent as syllabus_progress/module
// completion), not a third stored state that could drift out of sync.
enum HostelBedStatus {
  AVAILABLE
  MAINTENANCE
}

model HostelBed {
  id             String          @id @default(uuid())
  organizationId String
  roomId         String
  label          String
  status         HostelBedStatus @default(AVAILABLE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id])
  room         HostelRoom        @relation(fields: [roomId], references: [id])
  allocation   HostelAllocation?

  @@unique([roomId, label])
  @@index([organizationId])
  @@map("hostel_beds")
}

model HostelAllocation {
  id                  String   @id @default(uuid())
  organizationId      String
  studentEnrollmentId String   @unique
  bedId               String   @unique
  allocatedAt         DateTime @default(now())

  organization      Organization       @relation(fields: [organizationId], references: [id])
  studentEnrollment StudentEnrollment  @relation(fields: [studentEnrollmentId], references: [id])
  bed               HostelBed          @relation(fields: [bedId], references: [id])
  attendance        HostelAttendance[]
  visitors          HostelVisitor[]
  complaints        HostelComplaint[]

  // One current bed per enrollment and one current occupant per bed —
  // same "current pointer, admin repoints it rather than stacking
  // history" precedent as StudentTransportAssignment; reassigning a
  // student to a different bed updates this row rather than adding a
  // second one, and frees their old bed for the next occupant.
  @@index([organizationId])
  @@map("hostel_allocations")
}

enum HostelAttendanceStatus {
  PRESENT
  ABSENT
  ON_LEAVE
}

model HostelAttendance {
  id                 String                 @id @default(uuid())
  organizationId     String
  hostelAllocationId String
  date               DateTime
  status             HostelAttendanceStatus
  markedAt           DateTime               @default(now())

  organization     Organization     @relation(fields: [organizationId], references: [id])
  hostelAllocation HostelAllocation @relation(fields: [hostelAllocationId], references: [id])

  @@unique([hostelAllocationId, date])
  @@index([organizationId])
  @@map("hostel_attendance")
}

model HostelVisitor {
  id                 String    @id @default(uuid())
  organizationId     String
  hostelAllocationId String
  visitorName        String
  relation           String?
  checkInAt          DateTime  @default(now())
  checkOutAt         DateTime?

  organization     Organization     @relation(fields: [organizationId], references: [id])
  hostelAllocation HostelAllocation @relation(fields: [hostelAllocationId], references: [id])

  @@index([organizationId])
  @@map("hostel_visitors")
}

enum HostelComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model HostelComplaint {
  id                 String                @id @default(uuid())
  organizationId     String
  hostelAllocationId String
  category           String
  description        String
  status             HostelComplaintStatus @default(OPEN)
  raisedAt           DateTime              @default(now())
  resolvedAt         DateTime?
  resolutionNotes    String?

  organization     Organization     @relation(fields: [organizationId], references: [id])
  hostelAllocation HostelAllocation @relation(fields: [hostelAllocationId], references: [id])

  @@index([organizationId])
  @@map("hostel_complaints")
}

enum HostelMaintenanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model HostelMaintenanceRequest {
  id             String                  @id @default(uuid())
  organizationId String
  roomId         String
  description    String
  status         HostelMaintenanceStatus @default(OPEN)
  reportedAt     DateTime                @default(now())
  resolvedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  room         HostelRoom   @relation(fields: [roomId], references: [id])

  @@index([organizationId])
  @@map("hostel_maintenance")
}

// Standardization lookup lists — room/bed type, visitor relation, and
// complaint category were all plain free-text strings, which lets
// the same real-world value get typo'd a dozen different ways across
// data entry ("Standard" vs "standard" vs "Std"). One small
// org-scoped catalog table with a `kind` discriminator (rather than
// three near-identical one-off tables) covers all three — same
// "admin-configurable, not hardcoded" reasoning as FeeCategory/
// StaffType/SalaryStructureItem elsewhere in this project, just
// generalized across a `kind` column instead of duplicated per
// field. The room/visitor/complaint rows themselves keep storing a
// plain string (not a hard FK) — the web UI sources its select's
// options from this catalog and can add a new one inline, but a
// lookup row being renamed or removed later never orphans or blocks
// deleting historical room/visitor/complaint data.
enum HostelLookupKind {
  ROOM_TYPE
  VISITOR_RELATION
  COMPLAINT_CATEGORY
}

model HostelLookup {
  id             String           @id @default(uuid())
  organizationId String
  kind           HostelLookupKind
  name           String
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, kind, name])
  @@index([organizationId])
  @@map("hostel_lookups")
}

// ── Inventory (Phase 7 slice 7f) ───────────────────────────────────────
// Plan's ERD (docx §14/§20): inventory_categories, items, suppliers,
// purchase_orders, stock_movements, assets, asset_assignments — seven
// tables, no purchase_order_items or asset_assignments-history table
// named explicitly, but a PO needs line items the same way every other
// "structure + items" pair in this project does (FeeStructure/
// FeeStructureItem, SalaryStructure/SalaryStructureItem), so
// PurchaseOrderItem is added on that precedent, not scope creep.
//
// InventoryItem.currentStock is deliberately NOT a stored column —
// same "computed, not stored" precedent as HostelBed's occupancy and
// syllabus_progress: it's the signed sum of that item's
// StockMovement rows (IN positive, OUT/ADJUSTMENT-down negative),
// computed at read time via a groupBy, so the ledger (StockMovement)
// stays the single source of truth and can never drift out of sync
// with a cached total. StockMovement rows are also the plan's own
// "stock audit" trail — an immutable, append-only ledger, not a
// separate stock_audit table.
//
// AssetAssignment keeps real history (assignedAt/returnedAt, a new
// row per assignment), unlike HostelAllocation/
// StudentTransportAssignment's "current pointer, repoint on
// reassignment" precedent — a physical asset's custody trail (who
// had the laptop and when) is exactly the kind of accountability
// record this project already keeps for HostelVisitor's
// checkInAt/checkOutAt open/closed-record shape, so that's the
// pattern reused here instead.

model InventoryCategory {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String
  createdAt      DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id])
  items        InventoryItem[]
  assets       Asset[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("inventory_categories")
}

model Supplier {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  contactName    String?
  phone          String?
  email          String?
  address        String?
  createdAt      DateTime @default(now())

  organization   Organization    @relation(fields: [organizationId], references: [id])
  purchaseOrders PurchaseOrder[]

  @@index([organizationId])
  @@map("suppliers")
}

model InventoryItem {
  id             String   @id @default(uuid())
  organizationId String
  categoryId     String
  name           String
  sku            String
  unit           String
  barcode        String?
  reorderLevel   Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id])
  category           InventoryCategory   @relation(fields: [categoryId], references: [id])
  stockMovements     StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@map("inventory_items")
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id             String              @id @default(uuid())
  organizationId String
  supplierId     String
  status         PurchaseOrderStatus @default(DRAFT)
  orderDate      DateTime            @default(now())
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id])
  supplier       Supplier            @relation(fields: [supplierId], references: [id])
  items          PurchaseOrderItem[]
  stockMovements StockMovement[]

  @@index([organizationId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String  @id @default(uuid())
  organizationId   String
  purchaseOrderId  String
  itemId           String
  quantityOrdered  Int
  quantityReceived Int     @default(0)
  unitPrice        Decimal @db.Decimal(12, 2)

  organization  Organization  @relation(fields: [organizationId], references: [id])
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  item          InventoryItem @relation(fields: [itemId], references: [id])

  @@index([organizationId])
  @@map("purchase_order_items")
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

model StockMovement {
  id              String            @id @default(uuid())
  organizationId  String
  itemId          String
  type            StockMovementType
  quantity        Int
  reason          String?
  purchaseOrderId String?
  movementDate    DateTime          @default(now())

  organization  Organization   @relation(fields: [organizationId], references: [id])
  item          InventoryItem  @relation(fields: [itemId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  @@index([organizationId])
  @@index([itemId])
  @@map("stock_movements")
}

enum AssetStatus {
  AVAILABLE
  MAINTENANCE
  RETIRED
}

model Asset {
  id             String      @id @default(uuid())
  organizationId String
  categoryId     String?
  assetTag       String
  name           String
  purchaseDate   DateTime?
  purchaseCost   Decimal?    @db.Decimal(12, 2)
  status         AssetStatus @default(AVAILABLE)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id])
  category     InventoryCategory? @relation(fields: [categoryId], references: [id])
  assignments  AssetAssignment[]

  @@unique([organizationId, assetTag])
  @@index([organizationId])
  @@map("assets")
}

model AssetAssignment {
  id                   String    @id @default(uuid())
  organizationId       String
  assetId              String
  assignedToEmployeeId String
  assignedAt           DateTime  @default(now())
  returnedAt           DateTime?
  notes                String?

  organization       Organization @relation(fields: [organizationId], references: [id])
  asset              Asset        @relation(fields: [assetId], references: [id])
  assignedToEmployee Employee     @relation(fields: [assignedToEmployeeId], references: [id])

  @@index([organizationId])
  @@index([assetId])
  @@map("asset_assignments")
}

// ── Communication (Phase 7 slice 7g) ────────────────────────────────────
// Plan's ERD (docx §14/§20): announcements, notifications, messages,
// message_templates, email_logs, sms_logs, push_notifications — seven
// tables. Two of them already exist and are deliberately reused, not
// rebuilt: `Announcement` (LMS discovery slice 5, course-scoped
// teacher posts) and `Notification` (LMS discovery slice 9, in-app
// per-user). This slice adds the other five — org-wide admin
// broadcast messaging fanning out across email/SMS/push, reusing
// `Notification` itself for the in-app channel.
//
// Contact-field resolution is genuinely uneven across this project's
// existing models (checked directly, not assumed): Employee has
// email+phone+optional userId; Student has neither email nor phone of
// its own (only an optional userId once a portal login exists);
// Guardian has phone+optional email but NO userId at all — guardians
// have no login. So not every (audience, channel) combination is
// resolvable: SMS to ALL_STUDENTS and PUSH/IN_APP to ALL_GUARDIANS
// have no contact path in this data model and are rejected at the
// service layer (400) rather than silently sending nothing; a
// resolvable audience whose individual members are missing the
// needed field (e.g. one employee with no phone) are just skipped,
// not an error.
//
// Real email/SMS/push delivery needs a paid third-party provider
// (SendGrid/Twilio/FCM) this project has never depended on anywhere
// — same "no paid API as a hard dependency" rule already applied to
// AI. Delivery goes through a small pluggable provider interface
// with a log-only stub implementation (records the attempt, never
// hits a real network); wiring in a real provider is a clean,
// separate future step, not attempted here.

enum MessageChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum MessageAudience {
  ALL_STAFF
  ALL_STUDENTS
  ALL_GUARDIANS
  SPECIFIC_USER
}

enum MessageStatus {
  DRAFT
  SENT
  FAILED
}

model MessageTemplate {
  id             String         @id @default(uuid())
  organizationId String
  name           String
  channel        MessageChannel
  subject        String?
  body           String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  messages     Message[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("message_templates")
}

model Message {
  id              String          @id @default(uuid())
  organizationId  String
  createdByUserId String
  templateId      String?
  channel         MessageChannel
  audience        MessageAudience
  // Only meaningful (and required) when audience = SPECIFIC_USER.
  recipientUserId String?
  subject         String?
  body            String
  status          MessageStatus   @default(DRAFT)
  sentAt          DateTime?
  createdAt       DateTime        @default(now())

  organization  Organization          @relation(fields: [organizationId], references: [id])
  createdBy     User                  @relation("MessagesCreated", fields: [createdByUserId], references: [id])
  template      MessageTemplate?      @relation(fields: [templateId], references: [id])
  recipientUser User?                 @relation("MessagesToSpecificUser", fields: [recipientUserId], references: [id])
  emailLogs     EmailLog[]
  smsLogs       SmsLog[]
  pushLogs      PushNotificationLog[]

  @@index([organizationId])
  @@map("messages")
}

enum DeliveryStatus {
  SENT
  FAILED
}

model EmailLog {
  id               String         @id @default(uuid())
  organizationId   String
  messageId        String
  recipientEmail   String
  recipientName    String?
  status           DeliveryStatus
  providerResponse String?
  sentAt           DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  message      Message      @relation(fields: [messageId], references: [id])

  @@index([organizationId])
  @@index([messageId])
  @@map("email_logs")
}

model SmsLog {
  id               String         @id @default(uuid())
  organizationId   String
  messageId        String
  recipientPhone   String
  recipientName    String?
  status           DeliveryStatus
  providerResponse String?
  sentAt           DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  message      Message      @relation(fields: [messageId], references: [id])

  @@index([organizationId])
  @@index([messageId])
  @@map("sms_logs")
}

model PushNotificationLog {
  id               String         @id @default(uuid())
  organizationId   String
  messageId        String
  recipientUserId  String
  status           DeliveryStatus
  providerResponse String?
  sentAt           DateTime       @default(now())

  organization  Organization @relation(fields: [organizationId], references: [id])
  message       Message      @relation(fields: [messageId], references: [id])
  recipientUser User         @relation("PushLogsToUser", fields: [recipientUserId], references: [id])

  @@index([organizationId])
  @@index([messageId])
  @@map("push_notifications")
}

// ── Documents & Certificates (Phase 7h) ─────────────────────────────────
// The plan's prose for this domain (docx §14) is "Institution/student
// documents, certificates, transcripts, verification and controlled
// access" — but unlike every other Phase 7 domain, the plan's own
// detailed ERD pass (docx §20) never gives this domain a section of
// its own; it only names `student_documents` under Student's own ERD
// list and `staff_documents` under Staff's. Built on that literal
// naming rather than inventing a generic cross-domain "Document"
// abstraction the plan doesn't actually specify. "Institution
// documents" and "verification" are covered by Certificate below
// (an institution-issued record, not a student-submitted upload) —
// no separate institution-level document library is built, since
// nothing in the plan's ERD names one.

enum DocumentReviewStatus {
  PENDING
  VERIFIED
  REJECTED
}

model StudentDocument {
  id               String               @id @default(uuid())
  organizationId   String
  studentId        String
  documentType     String
  fileUrl          String
  status           DocumentReviewStatus @default(PENDING)
  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewNotes      String?
  uploadedAt       DateTime             @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id])
  reviewedBy   User?        @relation("StudentDocumentsReviewed", fields: [reviewedByUserId], references: [id])

  @@index([organizationId])
  @@index([studentId])
  @@map("student_documents")
}

model StaffDocument {
  id               String               @id @default(uuid())
  organizationId   String
  employeeId       String
  documentType     String
  fileUrl          String
  status           DocumentReviewStatus @default(PENDING)
  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewNotes      String?
  uploadedAt       DateTime             @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])
  reviewedBy   User?        @relation("StaffDocumentsReviewed", fields: [reviewedByUserId], references: [id])

  @@index([organizationId])
  @@index([employeeId])
  @@map("staff_documents")
}

enum CertificateStatus {
  ISSUED
  REVOKED
}

// Deliberately NOT under RLS — same reasoning already documented for
// User/Role/Session (Phase 1: "auth's login-by-email needs to work
// before a tenant context exists"). The public certificate
// verification endpoint (a third party checking an issued
// certificate's authenticity by its verificationCode) has the
// identical shape: it must look a row up with no tenant context
// available at all, which an RLS policy keyed on
// app.current_organization_id cannot do (no GUC set = no rows
// visible, full stop). Every authenticated CertificatesService query
// (list/create/revoke) explicitly filters/checks organizationId in
// application code instead — the same defense this project's own
// AuthService already relies on for User, not a new, weaker pattern
// invented just for this table.
model Certificate {
  id               String            @id @default(uuid())
  organizationId   String
  studentId        String
  type             String
  issuedAt         DateTime          @default(now())
  issuedByUserId   String
  fileUrl          String
  verificationCode String            @unique
  status           CertificateStatus @default(ISSUED)
  revokedAt        DateTime?
  revokedReason    String?

  organization Organization @relation(fields: [organizationId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id])
  issuedBy     User         @relation("CertificatesIssued", fields: [issuedByUserId], references: [id])

  @@index([organizationId])
  @@index([studentId])
  @@map("certificates")
}

// ── Alumni & Career, part 1 (Phase 8 slice 8a) ──────────────────────────
// Plan's ERD (docx §20) for this domain is genuinely large — fourteen
// tables: alumni_profiles, alumni_education, alumni_career_history,
// alumni_companies, alumni_skills, alumni_certifications,
// alumni_surveys, alumni_survey_responses, alumni_mentorship,
// career_opportunities, career_applications, alumni_achievements,
// career_services, graduate_outcomes. Split the same way every other
// large Phase 2-7 domain was: 8a shipped the core identity layer —
// the profile itself plus post-graduation education/career/company/
// skill/certification records. 8b added engagement: surveys,
// mentorship, achievements. 8c (this slice) adds career services:
// opportunities, applications, services, graduate outcomes. Only
// Analytics & Reports (8d) — aggregate dashboards over all of this —
// still needs its own go-ahead.
//
// An alumnus is a graduated Student (StudentStatus.GRADUATED already
// exists, set via the existing PATCH students/:id/status), converted
// into an AlumniProfile by an explicit admin action — not an automatic
// side effect of the status change, same "deliberate action, not an
// implicit trigger" precedent as computeGrade/generateReportCard.
// Self-service reuses the alumnus's EXISTING student-portal login
// (Student.userId) rather than inventing a parallel alumni auth
// system — an alumnus who already has a portal account keeps using
// it to manage their own alumni profile once one exists for them.

model AlumniProfile {
  id                String   @id @default(uuid())
  organizationId    String
  studentId         String   @unique
  graduationYear    Int
  currentOccupation String?
  currentEmployer   String?
  currentLocation   String?
  bio               String?
  linkedinUrl       String?
  isPubliclyVisible Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization        Organization           @relation(fields: [organizationId], references: [id])
  student             Student                @relation(fields: [studentId], references: [id])
  education           AlumniEducation[]
  careerHistory       AlumniCareerHistory[]
  skills              AlumniSkill[]
  certifications      AlumniCertification[]
  surveyResponses     AlumniSurveyResponse[]
  mentorships         AlumniMentorship[]
  achievements        AlumniAchievement[]
  postedOpportunities CareerOpportunity[]
  graduateOutcome     GraduateOutcome?

  @@index([organizationId])
  @@map("alumni_profiles")
}

model AlumniEducation {
  id              String   @id @default(uuid())
  organizationId  String
  alumniProfileId String
  institutionName String
  degree          String
  fieldOfStudy    String?
  startYear       Int?
  endYear         Int?
  notes           String?
  createdAt       DateTime @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id])
  alumniProfile AlumniProfile @relation(fields: [alumniProfileId], references: [id])

  @@index([organizationId])
  @@index([alumniProfileId])
  @@map("alumni_education")
}

// Simple org-scoped catalog, same "admin-configurable, not
// hardcoded" reasoning as HostelLookup — but unlike HostelLookup this
// one exists mainly so aggregate reporting ("how many alumni work at
// Company X") has something stable to group by, not primarily to
// standardize free-text entry. Career history entries always link to
// one via companyId; the web UI's picker can create a new one inline,
// same pattern as HostelLookup's own "+ Add new" flow.
model AlumniCompany {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  industry       String?
  website        String?
  createdAt      DateTime @default(now())

  organization  Organization          @relation(fields: [organizationId], references: [id])
  careerHistory AlumniCareerHistory[]
  opportunities CareerOpportunity[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("alumni_companies")
}

model AlumniCareerHistory {
  id              String    @id @default(uuid())
  organizationId  String
  alumniProfileId String
  companyId       String
  jobTitle        String
  startDate       DateTime
  endDate         DateTime?
  description     String?
  createdAt       DateTime  @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id])
  alumniProfile AlumniProfile @relation(fields: [alumniProfileId], references: [id])
  company       AlumniCompany @relation(fields: [companyId], references: [id])

  @@index([organizationId])
  @@index([alumniProfileId])
  @@map("alumni_career_history")
}

// Deliberately flat free text, not a catalog like AlumniCompany —
// skills are far more varied and personal than employer names, and
// there's no concrete reporting need (yet) that depends on exact-name
// grouping the way company aggregation does.
model AlumniSkill {
  id              String   @id @default(uuid())
  organizationId  String
  alumniProfileId String
  skillName       String
  createdAt       DateTime @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id])
  alumniProfile AlumniProfile @relation(fields: [alumniProfileId], references: [id])

  @@index([organizationId])
  @@index([alumniProfileId])
  @@map("alumni_skills")
}

model AlumniCertification {
  id                  String    @id @default(uuid())
  organizationId      String
  alumniProfileId     String
  name                String
  issuingOrganization String?
  issuedDate          DateTime?
  expiryDate          DateTime?
  credentialUrl       String?
  createdAt           DateTime  @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id])
  alumniProfile AlumniProfile @relation(fields: [alumniProfileId], references: [id])

  @@index([organizationId])
  @@index([alumniProfileId])
  @@map("alumni_certifications")
}

// ── Phase 8 slice 8b — Alumni engagement (surveys, mentorship,
// achievements) ──────────────────────────────────────────────────

enum AlumniSurveyStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

// Questions collapsed into one JSON array on the survey itself,
// same reasoning as KnowledgeCheckQuestion.options/SyllabusNode
// elsewhere in this project — a survey's question set has no need
// for independent identity or its own relations, so a separate
// Question table would be unused structure. Each element:
// { id: string, text: string, type: "TEXT"|"RATING"|"SINGLE_CHOICE",
// options?: string[] } (options only for SINGLE_CHOICE). Publishing
// locks the question set (mirrors KnowledgeCheck's publish-locks-
// questions precedent) — editing questions after PUBLISHED is 400.
model AlumniSurvey {
  id             String             @id @default(uuid())
  organizationId String
  title          String
  description    String?
  questions      Json
  status         AlumniSurveyStatus @default(DRAFT)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id])
  responses    AlumniSurveyResponse[]

  @@index([organizationId])
  @@map("alumni_surveys")
}

// One response per alumnus per survey (@@unique below) — a survey
// is answered once, not resubmitted, matching KnowledgeCheckAttempt's
// one-attempt precedent rather than Assignment's resubmission model
// (a feedback survey has no "resubmission allowed" concept in the
// plan). answers: [{ questionId: string, value: string | number }].
// Only accepted while the parent survey is PUBLISHED.
model AlumniSurveyResponse {
  id              String   @id @default(uuid())
  organizationId  String
  surveyId        String
  alumniProfileId String
  answers         Json
  submittedAt     DateTime @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id])
  survey        AlumniSurvey  @relation(fields: [surveyId], references: [id])
  alumniProfile AlumniProfile @relation(fields: [alumniProfileId], references: [id])

  @@unique([surveyId, alumniProfileId])
  @@index([organizationId])
  @@map("alumni_survey_responses")
}

enum MentorshipStatus {
  REQUESTED
  ACTIVE
  DECLINED
  COMPLETED
}

// Alumni mentoring current students — the standard "give back to
// current students" shape of alumni mentorship (distinct from
// alumni-mentoring-alumni, which the plan never specifies and this
// project has no existing precedent for). An admin creates the
// pairing (mirrors HostelAllocation/StudentTransportAssignment —
// admin-brokered, not self-service-initiated, since there's no
// alumni directory/browse feature in this slice's scope for a
// student to discover a mentor on their own); the mentor then
// accepts/declines via their own portal (REQUESTED→ACTIVE/DECLINED,
// 409 on an invalid transition — same explicit-transition precedent
// as LeaveRequest/Payroll), and either side can mark ACTIVE→
// COMPLETED once the engagement is done.
model AlumniMentorship {
  id                    String           @id @default(uuid())
  organizationId        String
  mentorAlumniProfileId String
  menteeStudentId       String
  topic                 String?
  status                MentorshipStatus @default(REQUESTED)
  notes                 String?
  requestedAt           DateTime         @default(now())
  respondedAt           DateTime?
  completedAt           DateTime?

  organization        Organization  @relation(fields: [organizationId], references: [id])
  mentorAlumniProfile AlumniProfile @relation(fields: [mentorAlumniProfileId], references: [id])
  menteeStudent       Student       @relation(fields: [menteeStudentId], references: [id])

  @@index([organizationId])
  @@index([mentorAlumniProfileId])
  @@index([menteeStudentId])
  @@map("alumni_mentorship")
}

// Both admin- and self-addable (same pattern as
// AlumniEducation/AlumniSkill/AlumniCertification) — an institution
// might record an honor it grants ("Distinguished Alumnus Award"),
// and an alumnus might record their own accomplishment.
model AlumniAchievement {
  id              String    @id @default(uuid())
  organizationId  String
  alumniProfileId String
  title           String
  description     String?
  achievedAt      DateTime?
  createdAt       DateTime  @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id])
  alumniProfile AlumniProfile @relation(fields: [alumniProfileId], references: [id])

  @@index([organizationId])
  @@index([alumniProfileId])
  @@map("alumni_achievements")
}

// ── Phase 8 slice 8c — Career services (opportunities, applications,
// services, graduate outcomes) ────────────────────────────────────

enum OpportunityType {
  JOB
  INTERNSHIP
}

enum OpportunityStatus {
  PENDING
  APPROVED
  REJECTED
  CLOSED
}

// Reuses AlumniCompany (companyId), same "real catalog, mainly for
// aggregate reporting" reasoning as career history — "which companies
// are hiring the most" is exactly the kind of question this makes
// answerable. postedByAlumniProfileId is nullable: an admin-posted
// opportunity has no alumni poster and is APPROVED immediately (no
// self-review needed); an alumnus-submitted one (the plan's own
// "approved opportunities" phrasing for the Alumni role view implies
// exactly this two-source, one-approval-gate model) starts PENDING
// and needs an explicit admin approve/reject — same moderation-gate
// shape as AlumniSurvey's publish step, but with an added self-
// submission channel surveys don't have.
model CareerOpportunity {
  id                      String            @id @default(uuid())
  organizationId          String
  postedByAlumniProfileId String?
  companyId               String
  title                   String
  type                    OpportunityType
  description             String
  location                String?
  status                  OpportunityStatus @default(PENDING)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  organization          Organization        @relation(fields: [organizationId], references: [id])
  postedByAlumniProfile AlumniProfile?      @relation(fields: [postedByAlumniProfileId], references: [id])
  company               AlumniCompany       @relation(fields: [companyId], references: [id])
  applications          CareerApplication[]

  @@index([organizationId])
  @@index([companyId])
  @@map("career_opportunities")
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  REJECTED
  ACCEPTED
  WITHDRAWN
}

// Applicant is a Student, not an AlumniProfile — career services
// serves current students (job placement) and alumni alike, and
// Student already covers both regardless of graduation status (same
// "one identity, no parallel model" reasoning as reusing the existing
// portal login for alumni self-service throughout this domain).
// @@unique stops one applicant spamming the same opportunity twice.
// Review (UNDER_REVIEW/SHORTLISTED/REJECTED/ACCEPTED) is admin-only
// even for an alumni-posted opportunity — giving the original poster
// their own review authority over applicants is real added complexity
// the plan doesn't call for; the institution's career office manages
// the process end to end, matching this project's standing
// "don't build unrequested flexibility" precedent (e.g. mentorship
// stayed alumni-to-student only, no alumni-to-alumni). WITHDRAWN is
// the one self-service transition, from the applicant's own side.
model CareerApplication {
  id                 String            @id @default(uuid())
  organizationId     String
  opportunityId      String
  applicantStudentId String
  status             ApplicationStatus @default(SUBMITTED)
  coverNote          String?
  reviewNotes        String?
  submittedAt        DateTime          @default(now())
  reviewedAt         DateTime?

  organization     Organization      @relation(fields: [organizationId], references: [id])
  opportunity      CareerOpportunity @relation(fields: [opportunityId], references: [id])
  applicantStudent Student           @relation(fields: [applicantStudentId], references: [id])

  @@unique([opportunityId, applicantStudentId])
  @@index([organizationId])
  @@index([applicantStudentId])
  @@map("career_applications")
}

// A simple, admin-configurable listing (resume review, mock
// interviews, career counseling, etc.) — no reservation/scheduling
// system, matching this project's "defer a booking engine until
// actually asked for" precedent (e.g. Class Sessions in Phase 3
// avoided the same scope). Alumni/students browse what's offered and
// use the listed contact info directly.
model CareerService {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  contactEmail   String?
  contactPhone   String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("career_services")
}

enum EmploymentStatus {
  EMPLOYED
  SELF_EMPLOYED
  FURTHER_STUDY
  UNEMPLOYED_SEEKING
  UNEMPLOYED_NOT_SEEKING
  UNKNOWN
}

// Deliberately distinct from AlumniProfile.currentOccupation/
// currentEmployer (8a) — those are an informal, always-current self-
// reported bio field; this is the institution's structured outcome
// record (the plan's own separate graduate_outcomes ERD table,
// distinct from alumni_surveys/alumni_survey_responses too — a
// generic JSON survey response isn't queryable/reportable the way
// dedicated columns are, which is the whole point of tracking this
// separately). One row per alumnus (@@unique) — a snapshot of their
// latest known status, editable by an admin or the alumnus
// themselves, not a dated history (no "outcomes over time" scope was
// asked for). Feeds the plan's separate Analytics & Reports slice
// (8d, "Alumni/graduate outcomes" dashboards) — not aggregated here.
model GraduateOutcome {
  id                    String           @id @default(uuid())
  organizationId        String
  alumniProfileId       String           @unique
  employmentStatus      EmploymentStatus
  employerOrInstitution String?
  fieldRelatedToStudy   Boolean?
  notes                 String?
  recordedAt            DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id])
  alumniProfile AlumniProfile @relation(fields: [alumniProfileId], references: [id])

  @@index([organizationId])
  @@map("graduate_outcomes")
}

// ── Platform administration (licensing editions) ────────────────────────
// A genuinely global, cross-org identity — deliberately NOT a `User`
// row, which requires organizationId on every record (every existing
// login is tenant-bound by design). Follows the same "no
// organizationId, no RLS policy" shape `Permission` already
// establishes for a table that's intentionally not tenant data. Its
// one capability is viewing every org's usage and setting its
// Edition — never reading tenant data itself, which stays exactly as
// isolated as it's always been.
model PlatformAdmin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("platform_admins")
}

// A self-hosted (svg-captcha, in-process, no external service —
// matches this project's standing "no third-party API as a hard
// dependency" precedent already applied to AI and maps) human-
// verification challenge, gating both /auth/login and
// /platform/auth/login. Persisted in Postgres rather than in-process
// memory specifically because this project has a serverless
// deployment path (services/api/api/index.ts) where in-memory state
// wouldn't survive between invocations. `answer` is argon2-hashed —
// not a secret asset, but no reason to store it in the clear either.
// `consumedAt` makes a solved challenge single-use.
model Captcha {
  id         String    @id @default(uuid())
  answer     String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@map("captchas")
}

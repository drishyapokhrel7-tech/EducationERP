{
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "functions": {
    "api/index.ts": {
      "includeFiles": "{node_modules/pdfkit/js,tessdata}/**",
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/internal/health-watchdog", "schedule": "0 6 * * *" },
    { "path": "/internal/apply-late-fees", "schedule": "0 7 * * *" }
  ]
}

DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Non-BYPASSRLS role for the running API — DATABASE_URL is for `prisma
# migrate` only. See services/api/prisma/migrations/*_row_level_security.
RUNTIME_DATABASE_URL="postgresql://app_runtime:password@host/dbname?sslmode=require"
REDIS_URL="redis://localhost:6379"
# Access tokens are signed JWTs; refresh tokens are opaque random strings
# stored hashed in the `sessions` table, so no separate refresh secret.
JWT_ACCESS_SECRET="change-me"
JWT_ACCESS_TTL_SECONDS=900
PORT=4000
CORS_ORIGIN="http://localhost:3020"
# Guards GET /internal/health-watchdog (see docs/OBSERVABILITY.md and
# docs/DEPLOYMENT.md's Cron section) — leave unset locally, the route
# fails closed (401) without it, same as production until a Cron
# schedule + this secret are both configured on the real deploy.
CRON_SECRET=""
# Recipient for the watchdog's failure emails (sent via the existing
# Gmail integration, EMAIL_DRIVER="gmail" — see delivery-provider.ts).
# Leave unset to just log server-side instead of emailing.
ALERT_EMAIL=""
